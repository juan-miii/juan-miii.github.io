{
	"$schema": "https://turborepo.dev/schema.json",
	"globalDependencies": [
		".config/mise.toml",
		".config/mise.lock",
		"pnpm-lock.yaml"
	],
	"tasks": {
		"dev": {
			"cache": false,
			"persistent": true
		},
		"check": {
			"dependsOn": ["^check"]
		},
		"build": {
			"dependsOn": ["^build"],
			"outputs": ["dist/**"]
		},
		"test": {
			"dependsOn": ["^build"],
			"cache": false
		},
		"lint": {
			"cache": false
		}
	}
}
