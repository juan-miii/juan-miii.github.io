---
import GitHub from "@/assets/GitHub.astro";
import MailIcon from "@/assets/MailIcon.astro";
import { getLangFromUrl, useTranslations } from "@/i18n/utils";
import Badge from "./Badge.astro";
import SocialBucket from "./SocialBucket.astro";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const avatarAlt = "juan-miii avatar";
---

<div class="max-w-xl">
  <div class="flex gap-4 mb-4">
    <img
      class="rounded-full shadow-lg size-16"
      src="/profile.webp"
      alt={avatarAlt}
    />

    <a
      href="mailto:94069179-juan-miii@proton.me"
      target="_blank"
      rel="noopener noreferrer"
      class="flex items-center transition md:justify-center md:hover:scale-105"
    >
      <Badge>{t("hero.badge")}</Badge>
    </a>
  </div>

  <h1
    class="text-4xl font-bold tracking-tight text-gray-800 sm:text-5xl dark:text-white"
  >
    {t("hero.title")}
  </h1>

  <p
    class="mt-6 text-xl text-gray-800 dark:[&>strong]:text-blue-300 [&>strong]:text-blue-500 [&>strong]:font-semibold dark:text-gray-200"
    set:html={t("hero.bio")}
  />

  <nav class="flex flex-wrap gap-4 mt-8">
    <SocialBucket href="mailto:94069179-juan-miii@proton.me">
      <MailIcon class="size-4" />
      {t("hero.mail")}
    </SocialBucket>
    <SocialBucket href="https://github.com/juan-miii">
      <GitHub class="size-4" />
      {t("social.github")}
    </SocialBucket>
  </nav>
</div>
