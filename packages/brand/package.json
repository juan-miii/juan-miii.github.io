{
	"name": "@juan-miii/brand",
	"version": "0.1.0",
	"description": "Design tokens, base styles and motion CSS for Juan Miguel's portfolio brand. Published as an unscoped package by renaming the scope first.",
	"private": false,
	"type": "module",
	"main": "./src/index.ts",
	"types": "./src/index.ts",
	"sideEffects": [
		"./src/styles/*.css"
	],
	"publishConfig": {
		"access": "public",
		"provenance": true
	},
	"author": "Juan Miguel",
	"license": "AGPL-3.0-or-later",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/juan-miii/juan-miii.github.io.git",
		"directory": "packages/brand"
	},
	"homepage": "https://github.com/juan-miii/juan-miii.github.io/tree/main/packages/brand",
	"bugs": {
		"url": "https://github.com/juan-miii/juan-miii.github.io/issues"
	},
	"keywords": [
		"design-tokens",
		"css",
		"brand",
		"ui",
		"astro",
		"portfolio"
	],
	"files": [
		"src/**",
		"README.md"
	],
	"exports": {
		"./styles/tokens.css": "./src/styles/tokens.css",
		"./styles/base.css": "./src/styles/base.css",
		"./styles/icons.css": "./src/styles/icons.css",
		"./styles/layout.css": "./src/styles/layout.css",
		"./styles/components.css": "./src/styles/components.css",
		"./styles/motion.css": "./src/styles/motion.css",
		"./styles/loader.css": "./src/styles/loader.css"
	},
	"scripts": {
		"test": "echo 'No unit tests yet'"
	}
}
