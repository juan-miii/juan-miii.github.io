---
import type { HTMLAttributes } from "astro/types";

type Props = Pick<HTMLAttributes<"svg">, "class" | "style" | "id"> & {
  size?: "sm" | "md" | "lg";
};

const { size = "md", class: className, ...attributes } = Astro.props;
---

<svg
  {...attributes}
  class:list={["icon", className]}
  data-size={size}
  xmlns="http://www.w3.org/2000/svg"
  width="24"
  height="24"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
   <slot /> <!-- SVG -->
</svg>