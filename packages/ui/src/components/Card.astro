---
import type { HTMLAttributes } from "astro/types";

type Props = HTMLAttributes<"article"> & {
	title?: string;
	description?: string;
	transitionName?: string;
	as?: "article" | "section" | "div";
};

const { title, description, transitionName, as = "article", class: className, ...attributes } = Astro.props;
const Tag = as;
---

<Tag class:list={["card", className]} {...attributes}>
	<div class="card-glow"></div>
	<div class="card-content">
		{
			title && (
				<header class="card-header">
					<h3 class="card-title" style={transitionName ? `view-transition-name: ${transitionName}` : undefined}>
						{title}
					</h3>
					{description && <p class="card-description">{description}</p>}
				</header>
			)
		}
		<div class="card-body">
			<slot />
		</div>
	</div>
</Tag>

<style>
	.card {
		position: relative;
		height: 100%;
	}

	.card-glow {
		position: absolute;
		inset: 0;
		border-radius: var(--radius-2xl);
		background: radial-gradient(circle at top, color-mix(in srgb, var(--color-accent) 8%, transparent), transparent 60%);
		opacity: 0;
		transition: opacity var(--motion-slow) var(--motion-easing);
		pointer-events: none;
	}

	.card:hover .card-glow,
	.card:focus-within .card-glow {
		opacity: 1;
	}

	.card-content {
		position: relative;
		display: grid;
		gap: var(--space-4);
		height: 100%;
		padding: var(--space-6);
		background: var(--color-surface);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-2xl);
		box-shadow: var(--shadow-sm);
		transition: all var(--motion-base) var(--motion-easing);
	}

	.card:hover .card-content,
	.card:focus-within .card-content {
		border-color: color-mix(in srgb, var(--color-accent) 40%, var(--color-border));
		box-shadow: var(--shadow-lg);
		transform: translateY(-2px);
	}

	.card-header {
		display: grid;
		gap: var(--space-2);
	}

	.card-title {
		margin: 0;
		font-size: var(--text-xl);
		letter-spacing: -0.01em;
	}

	.card-description {
		margin: 0;
		color: var(--color-text-muted);
	}

	.card-body {
		display: grid;
		gap: var(--space-4);
		color: var(--color-text-muted);
	}

	.card-body :global(p) {
		color: var(--color-text-muted);
		margin: 0;
	}

	.card-body :global(ul) {
		color: var(--color-text-muted);
		margin: 0;
	}
</style>
