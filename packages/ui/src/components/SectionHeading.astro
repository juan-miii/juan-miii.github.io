---
import type { HTMLAttributes } from "astro/types";
import NodeLabel from "./NodeLabel.astro";

interface Props extends HTMLAttributes<"header"> {
	id: string;
	index: string;
	label: string;
	title: string;
	body?: string;
	/** Mark the node label as a trace anchor. Defaults to true. */
	anchor?: boolean;
}

const {
	id,
	index,
	label,
	title,
	body,
	anchor = true,
	class: className,
	...attributes
} = Astro.props;
---

<header {...attributes} class:list={["base-section-head", className]}>
	<div class="base-section-head__label">
		<NodeLabel index={index} data-trace-anchor={anchor ? "" : undefined}>
			{label !== title && label}
		</NodeLabel>
	</div>
	<h2 id={id} class="base-section-head__title" data-split="lines">{title}</h2>
	{body && <p class="base-section-head__body">{body}</p>}
</header>
