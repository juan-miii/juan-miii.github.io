---
import type { HTMLAttributes } from "astro/types";

type Props = HTMLAttributes<"header"> & {
	id?: string;
	eyebrow?: string;
};

const { id, eyebrow, class: className, ...attributes } = Astro.props;
---

<header class:list={["section-header", className]} {...attributes}>
	{eyebrow && <p class="section-eyebrow">{eyebrow}</p>}
	<h2 id={id} class="section-heading">
		<slot />
	</h2>
</header>

<style>
	.section-header {
		display: flex;
		flex-direction: column;
		gap: var(--space-2);
		margin-bottom: var(--space-10);
	}

	.section-eyebrow {
		font-size: var(--text-sm);
		text-transform: uppercase;
		letter-spacing: 0.2em;
		color: var(--color-text-subtle);
		margin: 0;
	}

	.section-heading {
		display: flex;
		align-items: center;
		gap: var(--space-3);
		margin: 0;
	}

	.section-heading :global(svg) {
		width: 1.75rem;
		height: 1.75rem;
		color: var(--color-accent);
		flex-shrink: 0;
	}
</style>
