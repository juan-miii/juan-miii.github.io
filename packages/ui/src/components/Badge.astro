---
import type { HTMLAttributes } from "astro/types";

type Props = HTMLAttributes<"span"> & {
	variant?: "neutral" | "accent" | "success" | "warning" | "info" | "muted";
};

const { variant = "neutral", class: className, ...attributes } = Astro.props;
---

<span class:list={["badge", `badge--${variant}`, className]} {...attributes}>
	<slot />
</span>

<style>
	.badge {
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
		padding: 0.2rem 0.65rem;
		border-radius: 999px;
		font-size: 0.85rem;
		line-height: 1.2;
		border: 1px solid var(--color-border, #d8d5cd);
		background: var(--color-surface, #fbfaf7);
		color: var(--color-text-muted, #6d7168);
	}

	.badge--accent {
		background: var(--color-accent, #285b3c);
		color: var(--color-text-inverse, #fbfaf7);
		border-color: var(--color-accent, #285b3c);
	}

	.badge--success {
		background: color-mix(in oklab, var(--color-accent, #285b3c) 18%, white);
		color: var(--color-accent, #285b3c);
	}

	.badge--info {
		background: #e8f1ff;
		color: #154a8c;
		border-color: #bcd3f5;
	}

	.badge--muted {
		background: transparent;
		color: var(--color-text-muted, #6d7168);
	}

	.badge--warning {
		background: #fff3cd;
		color: #6b4a00;
		border-color: #f0d68a;
	}
</style>
