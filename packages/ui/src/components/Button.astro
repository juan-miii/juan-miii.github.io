---
import type { HTMLAttributes } from "astro/types";

type Variant = "solid" | "line" | "light" | "accent";

interface Props extends HTMLAttributes<"a"> {
	href?: string;
	variant?: Variant;
	type?: "button" | "submit" | "reset";
}

const {
	href,
	variant = "line",
	type = "button",
	class: className,
	...attributes
} = Astro.props;

const classes = [`base-btn`, `base-btn--${variant}`, className];
---

{
	href ? (
		<a {...attributes} href={href} class:list={classes}>
			<slot />
		</a>
	) : (
		<button {...attributes} type={type} class:list={classes}>
			<slot />
		</button>
	)
}