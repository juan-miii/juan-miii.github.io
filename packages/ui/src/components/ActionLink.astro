---
import type { HTMLAttributes } from "astro/types";

type Props = HTMLAttributes<"a"> & {
	href: string;
	label?: string;
};

const { href, label, class: className, ...attributes } = Astro.props;
---

<a {...attributes} href={href} class:list={["action-link", className]}>
	{label ? label : <slot />}
</a>

<style>
	.action-link {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: var(--space-2, 0.5rem);
		padding: var(--space-2, 0.5rem) var(--space-4, 1rem);
		border: 1px solid var(--color-border, #d8d5cd);
		border-radius: 999px;
		background: var(--color-surface, #fbfaf7);
		color: var(--color-text, #22261f);
		text-decoration: none;
		font: inherit;
		cursor: pointer;
	}

	.action-link:hover,
	.action-link:focus-visible {
		background: var(--color-accent, #285b3c);
		color: var(--color-bg, #f6f5f1);
		border-color: var(--color-accent, #285b3c);
	}
</style>
