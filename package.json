{
	"name": "portfolio",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"packageManager": "pnpm@12.15.0",
	"engines": {
		"node": ">=24"
	},
	"scripts": {
		"dev": "turbo run dev --filter=@portfolio/web",
		"build": "turbo run build",
		"preview": "pnpm --filter @portfolio/web preview",
		"lint": "biome lint .",
		"format": "biome format --write .",
		"format:check": "biome format .",
		"typecheck": "turbo run check",
		"check": "pnpm format:check && pnpm lint && pnpm typecheck"
	},
	"devDependencies": {
		"@biomejs/biome": "catalog:",
		"turbo": "catalog:"
	}
}
