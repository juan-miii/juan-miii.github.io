{
	"name": "portfolio",
	"version": "2.0.1",
	"private": true,
	"type": "module",
	"packageManager": "pnpm@12.18.0",
	"engines": {
		"node": ">=24"
	},
	"scripts": {
		"dev": "turbo run dev --filter=@portfolio/web",
		"build": "turbo run build",
		"preview": "pnpm --filter @portfolio/web preview",
		"lint": "biome lint .",
		"format": "biome format --write .",
		"format:check": "biome format .",
		"typecheck": "turbo run check",
		"check": "pnpm format:check && pnpm lint && pnpm typecheck",
		"content:check": "node apps/web/scripts/content-check.mjs",
		"test": "turbo run test",
		"test:e2e": "pnpm build && node apps/web/scripts/smoke.test.mjs",
		"test:a11y": "pnpm build && pnpm --filter @portfolio/web test:a11y",
		"test:visual": "echo 'No visual tests configured yet'",
		"changeset": "changeset",
		"version:packages": "changeset version"
	},
	"devDependencies": {
		"@biomejs/biome": "catalog:",
		"@changesets/cli": "catalog:",
		"lefthook": "catalog:",
		"turbo": "catalog:"
	}
}
