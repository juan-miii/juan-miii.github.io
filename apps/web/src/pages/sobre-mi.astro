---
import { getEntry } from "astro:content";

import ContactSection from "../components/ContactSection.astro";
import PageHeader from "../components/PageHeader.astro";
import PortraitPlate from "../components/PortraitPlate.astro";
import SectionHeading from "../components/SectionHeading.astro";
import BaseLayout from "../layouts/BaseLayout.astro";

const entry = await getEntry("pages", "site");
if (!entry) throw new Error("No existe el contenido del sitio.");
const site = entry.data;
---

<BaseLayout
	title={`Perfil / ${site.name}`}
	description={site.pages.about.description}
>
	<PageHeader
		index={site.pages.about.index}
		label={site.pages.about.label}
		title={site.pages.about.title}
		description={site.pages.about.description}
		meta={site.pages.about.meta}
	/>

	<section class="about section" aria-labelledby="bio-title">
		<div class="shell">
			<div class="about__grid">
				<div class="about__portrait">
					<PortraitPlate
						alt={`Retrato de ${site.name}`}
						caption={site.location.city}
						meta="Perfil / 05"
						eager
					/>
				</div>

				<div class="about__body">
					<span class="node-label" data-trace-anchor>
						<span class="node-label__index">01</span>
						Biografía
					</span>
					<h2 id="bio-title" class="visually-hidden">Biografía</h2>

					<div class="about__prose">
						{
							site.profile.long.map((paragraph, index) => (
								<p
									class:list={{ "about__lead": index === 0 }}
									data-reveal="up"
									data-delay={String(index * 0.05)}
								>
									{paragraph}
								</p>
							))
						}
					</div>

					<dl class="about__details">
						{
							site.profile.details.map((detail) => (
								<div>
									<dt class="mono">{detail.label}</dt>
									<dd>{detail.value}</dd>
								</div>
							))
						}
					</dl>
				</div>
			</div>
		</div>
	</section>

	<section class="principles section" aria-labelledby="principles-title">
		<div class="shell">
			<SectionHeading
				id="principles-title"
				index={site.principlesSection.index}
				label={site.principlesSection.label}
				title={site.principlesSection.title}
				body={site.principlesSection.body}
			/>

			<div class="principles__grid">
				{
					site.profile.principles.map((principle, index) => (
						<article data-reveal="up" data-delay={String(index * 0.06)}>
							<span class="mono principles__index">
								{String(index + 1).padStart(2, "0")}
							</span>
							<h3>{principle.title}</h3>
							<p>{principle.description}</p>
						</article>
					))
				}
			</div>
		</div>
	</section>

	<ContactSection contact={site.contact} email={site.email} />
</BaseLayout>

<style>
	.about {
		padding-block-start: clamp(2rem, 4vw, 3rem);
	}

	.visually-hidden {
		position: absolute;
		inline-size: 1px;
		block-size: 1px;
		overflow: hidden;
		clip-path: inset(50%);
		white-space: nowrap;
	}

	.about__grid {
		display: grid;
		gap: clamp(2.5rem, 6vw, 5rem);
		align-items: start;
	}

	.about__portrait {
		max-inline-size: 28rem;
	}

	.about__body {
		display: grid;
		gap: clamp(1.5rem, 3vw, 2.2rem);
	}

	.about__prose {
		display: grid;
		gap: 1rem;
		max-inline-size: 62ch;
	}

	.about__prose p {
		font-size: var(--t-body);
		line-height: 1.65;
		color: var(--c-muted);
	}

	.about__prose .about__lead {
		font-size: clamp(1.3rem, 2.2vw, 1.85rem);
		line-height: 1.35;
		letter-spacing: -0.025em;
		color: var(--c-ink);
	}

	.about__details {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 1rem;
		padding-block-start: 1.2rem;
		border-block-start: 1px solid var(--c-line);
	}

	.about__details dt {
		margin-block-end: 0.25rem;
		color: var(--c-muted);
	}

	.about__details dd {
		font-size: var(--t-s);
	}

	.principles__grid {
		display: grid;
		border-block-start: 1px solid var(--c-line);
	}

	.principles__grid article {
		display: grid;
		align-content: start;
		gap: 0.55rem;
		padding-block: clamp(1.5rem, 3vw, 2.3rem);
		border-block-end: 1px solid var(--c-line);
	}

	.principles__index {
		color: var(--c-accent-ink);
	}

	.principles__grid h3 {
		font-size: clamp(1.3rem, 2.2vw, 1.8rem);
		font-weight: 500;
		letter-spacing: -0.03em;
	}

	.principles__grid p {
		max-inline-size: 40ch;
		font-size: var(--t-s);
		color: var(--c-muted);
	}

	@media (min-width: 640px) {
		.principles__grid {
			grid-template-columns: repeat(3, minmax(0, 1fr));
		}

		.principles__grid article {
			border-inline-end: 1px solid var(--c-line);
			padding-inline: 1.2rem;
		}

		.principles__grid article:first-child {
			padding-inline-start: 0;
		}

		.principles__grid article:last-child {
			border-inline-end: 0;
			padding-inline-end: 0;
		}
	}

	@media (min-width: 900px) {
		.about__grid {
			grid-template-columns: minmax(0, 0.68fr) minmax(0, 1.32fr);
			gap: clamp(3rem, 7vw, 7rem);
		}

		.about__portrait {
			position: sticky;
			inset-block-start: calc(var(--header-h) + 2rem);
		}
	}
</style>
