---
import { getCollection, getEntry } from "astro:content";
import { Icon } from "astro-icon/components";

import PageHeader from "../../components/PageHeader.astro";
import ProjectRow from "../../components/ProjectRow.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";

const entry = await getEntry("pages", "site");
if (!entry) throw new Error("No existe el contenido del sitio.");
const site = entry.data;

const projects = (await getCollection("projects"))
	.filter((project) => project.data.publicationStatus === "published")
	.sort(
		(a, b) =>
			(a.data.featuredOrder ?? 999) - (b.data.featuredOrder ?? 999),
	);
---

<BaseLayout
	title={`Trabajo / ${site.name}`}
	description={site.pages.projects.description}
>
	<PageHeader
		index={site.pages.projects.index}
		label={site.pages.projects.label}
		title={site.pages.projects.title}
		description={site.pages.projects.description}
		meta={site.pages.projects.meta}
	/>

	<section class="projects section" aria-label="Proyectos publicados">
		<div class="shell">
			<div class="projects__list">
				{
					projects.map((project, index) => (
						<ProjectRow
							index={index + 1}
							slug={project.data.slug}
							title={project.data.title}
							summary={project.data.summary}
							role={project.data.role}
							year={project.data.year}
							status={project.data.statusLabel}
							technologies={project.data.technologies}
						/>
					))
				}
			</div>

			<div class="projects__note">
				<div>
					<span class="mono">Criterio de selección</span>
					<p>
						Solo aparece lo que puedo defender con el código, la cadena de
						entrega o la documentación. Sin clientes inventados, sin métricas
						de escaparate y sin capturas que no correspondan a un sistema real.
					</p>
				</div>
				<a class="link-arrow" href="/contacto/">
					Hablar de un proyecto
					<Icon name="tabler:arrow-up-right" aria-hidden="true" />
				</a>
			</div>
		</div>
	</section>
</BaseLayout>

<style>
	.projects {
		padding-block-start: clamp(2rem, 4vw, 3rem);
	}

	.projects__note {
		display: grid;
		gap: 1.5rem;
		margin-block-start: clamp(2.5rem, 6vw, 5rem);
		padding-block-start: 1.2rem;
		border-block-start: 1px solid var(--c-line);
	}

	.projects__note > div {
		display: grid;
		gap: 0.6rem;
	}

	.projects__note p {
		max-inline-size: 58ch;
		font-size: var(--t-s);
		color: var(--c-muted);
	}

	@media (min-width: 720px) {
		.projects__note {
			grid-template-columns: minmax(0, 1fr) auto;
			align-items: end;
		}
	}
</style>
