---
import { getEntry } from "astro:content";
import { Icon } from "astro-icon/components";

import BaseLayout from "../layouts/BaseLayout.astro";

const entry = await getEntry("pages", "site");
if (!entry) throw new Error("No existe el contenido del sitio.");
const site = entry.data;
const { notFound } = site;
---

<BaseLayout
	title={`${notFound.title} / ${site.name}`}
	description={notFound.description}
	noindex
>
	<section class="lost" aria-labelledby="lost-title">
		<div class="shell">
			<div class="lost__top">
				<span class="node-label" data-trace-anchor>
					<span class="node-label__index">{notFound.index}</span>
					{notFound.label}
				</span>
				<span class="mono lost__meta">Endpoint no resuelto</span>
			</div>

			<div class="lost__main">
				<div class="lost__copy">
					<h1 id="lost-title" class="lost__title" data-split="lines">
						{notFound.title}
					</h1>
					<p class="lost__description" data-reveal="up" data-delay="0.15">
						{notFound.description}
					</p>
					<div class="lost__actions">
						<a class="btn btn--solid" href={notFound.backHref}>
							{notFound.backLabel}
							<Icon name="tabler:arrow-right" aria-hidden="true" />
						</a>
						<a class="btn btn--line" href="/#contacto">Contacto</a>
					</div>
				</div>

				<div class="lost__diagram" aria-hidden="true">
					<span class="mono lost__diagram-label">Circuito / abierto</span>
					<svg viewBox="0 0 400 220">
						<path class="lost__bus" d="M 20 110 H 230" />
						<circle class="lost__port" cx="20" cy="110" r="4" />
						<circle class="lost__port" cx="230" cy="110" r="4" />
						<path class="lost__gap" d="M 270 110 H 340" />
						<circle class="lost__open" cx="360" cy="110" r="16" />
						<path class="lost__spark" d="M 360 86 V 72 M 360 134 V 148 M 336 110 H 322 M 384 110 H 398" />
						<text class="lost__label" x="20" y="140">señal</text>
						<text class="lost__label" x="360" y="160" text-anchor="middle">sin destino</text>
					</svg>
				</div>
			</div>

			<nav class="lost__nav" aria-label="Rutas disponibles">
				<a href="/#trabajo">Trabajo <Icon name="tabler:arrow-up-right" aria-hidden="true" /></a>
				<a href="/#perfil">Perfil <Icon name="tabler:arrow-up-right" aria-hidden="true" /></a>
				<a href="/#contacto">Contacto <Icon name="tabler:arrow-up-right" aria-hidden="true" /></a>
			</nav>
		</div>
	</section>
</BaseLayout>

<style>
	.lost {
		display: flex;
		align-items: stretch;
		min-block-size: calc(100svh - var(--header-h));
		padding-block: clamp(2rem, 5vw, 4rem);
	}

	.lost .shell {
		display: flex;
		flex-direction: column;
		justify-content: space-between;
		gap: clamp(3rem, 8vw, 6rem);
	}

	.lost__top {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 0.5rem 1.5rem;
		padding-block-end: 0.9rem;
		border-block-end: 1px solid var(--c-line);
	}

	.lost__meta {
		color: var(--c-accent-ink);
	}

	.lost__main {
		display: grid;
		gap: clamp(2.5rem, 6vw, 4rem);
		align-items: end;
	}

	.lost__copy {
		display: grid;
		gap: 1.4rem;
		justify-items: start;
	}

	.lost__title {
		max-inline-size: 14ch;
		font-size: var(--t-display);
		font-weight: 500;
		line-height: 0.88;
		letter-spacing: -0.05em;
	}

	.lost__description {
		max-inline-size: 44ch;
		font-size: var(--t-m);
		color: var(--c-muted);
	}

	.lost__actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.6rem;
		margin-block-start: 0.6rem;
	}

	.lost__diagram {
		display: grid;
		gap: 0.6rem;
		padding-block-start: 1rem;
		border-block-start: 1px solid var(--c-line);
	}

	.lost__diagram-label {
		color: var(--c-muted);
	}

	.lost__diagram svg {
		inline-size: 100%;
		block-size: auto;
	}

	.lost__bus {
		fill: none;
		stroke: var(--c-accent);
		stroke-width: 1.5;
	}

	.lost__gap {
		fill: none;
		stroke: var(--c-line-strong);
		stroke-width: 1;
		stroke-dasharray: 4 5;
	}

	.lost__port {
		fill: var(--c-accent);
	}

	.lost__open {
		fill: none;
		stroke: var(--c-accent);
		stroke-width: 1.5;
	}

	.lost__spark {
		fill: none;
		stroke: var(--c-accent);
		stroke-width: 1;
	}

	.lost__label {
		fill: var(--c-muted);
		font-family: var(--f-mono);
		font-size: 9px;
		letter-spacing: 0.05em;
		text-transform: uppercase;
	}

	.lost__nav {
		display: flex;
		flex-wrap: wrap;
		gap: 1rem 2rem;
		padding-block-start: 1rem;
		border-block-start: 1px solid var(--c-line);
	}

	.lost__nav a {
		display: inline-flex;
		align-items: center;
		gap: 0.3rem;
		font-size: var(--t-s);
	}

	.lost__nav :global(svg) {
		inline-size: 0.85rem;
		block-size: 0.85rem;
		color: var(--c-accent);
	}

	@media (min-width: 900px) {
		.lost__main {
			grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.7fr);
		}
	}
</style>
