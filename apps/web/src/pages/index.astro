---
import { getCollection, getEntry } from "astro:content";
import { Icon } from "astro-icon/components";

import ContactSection from "../components/ContactSection.astro";
import ExperienceList from "../components/ExperienceList.astro";
import Hero from "../components/Hero.astro";
import PortraitPlate from "../components/PortraitPlate.astro";
import ProjectRow from "../components/ProjectRow.astro";
import SectionHeading from "../components/SectionHeading.astro";
import TechStack from "../components/TechStack.astro";
import BaseLayout from "../layouts/BaseLayout.astro";

const entry = await getEntry("pages", "site");
if (!entry) throw new Error("No existe el contenido del sitio.");
const site = entry.data;

const projects = (await getCollection("projects"))
	.filter((project) => project.data.publicationStatus === "published")
	.sort(
		(a, b) =>
			(a.data.featuredOrder ?? 999) - (b.data.featuredOrder ?? 999),
	);

const capabilityIcons = [
	"tabler:route",
	"tabler:shield-check",
	"tabler:terminal-2",
	"tabler:git-branch",
];
---

<BaseLayout
	title={site.title}
	description={site.description}
	bodyClass="home"
>
	<Hero
		name={site.name}
		role={site.role}
		kicker={site.hero.kicker}
		firstName={site.hero.firstName}
		lastName={site.hero.lastName}
		intro={site.hero.intro}
		primaryAction={site.hero.primaryAction}
		secondaryAction={site.hero.secondaryAction}
		portraitCaption={site.hero.portraitCaption}
		scrollCue={site.hero.scrollCue}
		location={site.location}
		availability={site.availability}
	/>

	<section id="approach" class="section approach" aria-labelledby="approach-title">
		<div class="shell">
			<SectionHeading
				id="approach-title"
				index={site.approach.index}
				label={site.approach.label}
				title={site.approach.title}
				body={site.approach.body}
			/>

			<dl class="approach__notes">
				{
					site.approach.notes.map((note) => (
						<div class="approach__note" data-reveal="up">
							<dt class="mono">{note.label}</dt>
							<dd>{note.value}</dd>
						</div>
					))
				}
			</dl>
		</div>
	</section>

	<section id="work" class="section work" aria-labelledby="work-title">
		<div class="shell">
			<SectionHeading
				id="work-title"
				index={site.work.index}
				label={site.work.label}
				title={site.work.title}
				body={site.work.body}
			/>

			<div class="work__list">
				{
					projects.map((project, index) => (
						<ProjectRow
							index={index + 1}
							slug={project.data.slug}
							title={project.data.title}
							summary={project.data.summary}
							role={project.data.role}
							year={project.data.year}
							status={project.data.statusLabel}
							technologies={project.data.technologies}
						/>
					))
				}
			</div>

			<div class="section-foot">
				<a class="link-arrow" href="/proyectos/">
					Índice completo de proyectos
					<Icon name="tabler:arrow-right" aria-hidden="true" />
				</a>
			</div>
		</div>
	</section>

	<section id="capabilities" class="section capabilities" aria-labelledby="capabilities-title">
		<div class="shell">
			<SectionHeading
				id="capabilities-title"
				index={site.capabilities.index}
				label={site.capabilities.label}
				title={site.capabilities.title}
				body={site.capabilities.body}
			/>

			<div class="capabilities__grid">
				{
					site.capabilities.items.map((item, index) => (
						<article class="capability" data-reveal="up" data-delay={String(index * 0.05)}>
							<div class="capability__top">
								<span class="mono">{String(index + 1).padStart(2, "0")}</span>
								<Icon name={capabilityIcons[index]} aria-hidden="true" />
							</div>
							<h3>{item.title}</h3>
							<p>{item.description}</p>
							<ul class="capability__tools">
								{item.tools.map((tool) => <li>{tool}</li>)}
							</ul>
						</article>
					))
				}
			</div>

			<div class="capabilities__stack">
				<span class="mono">Herramientas en uso</span>
				<TechStack icons={site.capabilities.stack} />
			</div>
		</div>
	</section>

	<section id="experience" class="section experience" aria-labelledby="experience-title">
		<div class="shell">
			<SectionHeading
				id="experience-title"
				index={site.experienceSection.index}
				label={site.experienceSection.label}
				title={site.experienceSection.title}
				body={site.experienceSection.body}
			/>

			<ExperienceList />

			<div class="section-foot">
				<a class="link-arrow" href={site.experienceSection.link.href}>
					{site.experienceSection.link.label}
					<Icon name="tabler:arrow-right" aria-hidden="true" />
				</a>
			</div>
		</div>
	</section>

	<section id="profile" class="section profile" aria-labelledby="profile-title">
		<div class="shell">
			<SectionHeading
				id="profile-title"
				index={site.profile.index}
				label={site.profile.label}
				title={site.profile.title}
				body={site.profile.body}
			/>

			<div class="profile__grid">
				<div class="profile__copy">
					<div class="profile__principles">
						{
							site.profile.principles.map((principle) => (
								<article data-reveal="up">
									<h3>{principle.title}</h3>
									<p>{principle.description}</p>
								</article>
							))
						}
					</div>
					<a class="link-arrow" href={site.profile.link.href}>
						{site.profile.link.label}
						<Icon name="tabler:arrow-right" aria-hidden="true" />
					</a>
				</div>

				<PortraitPlate
					alt={`Retrato de ${site.name}`}
					caption={site.location.city}
					meta="Perfil / 05"
				/>
			</div>
		</div>
	</section>

	<ContactSection contact={site.contact} email={site.email} />
</BaseLayout>

<style>
	.approach__notes {
		display: grid;
		border-block-start: 1px solid var(--c-line);
	}

	.approach__note {
		display: grid;
		gap: 0.55rem;
		padding-block: 1.2rem;
		border-block-end: 1px solid var(--c-line);
	}

	.approach__note dt {
		color: var(--c-muted);
	}

	.approach__note dd {
		font-size: clamp(1.05rem, 1.5vw, 1.3rem);
		line-height: 1.35;
		letter-spacing: -0.02em;
	}

	.section-foot {
		display: flex;
		justify-content: flex-end;
		padding-block-start: 1.2rem;
	}

	.capabilities__grid {
		display: grid;
		border-block-start: 1px solid var(--c-line);
	}

	.capability {
		display: grid;
		align-content: start;
		gap: 0.8rem;
		padding-block: clamp(1.5rem, 3vw, 2.2rem);
		border-block-end: 1px solid var(--c-line);
	}

	.capability__top {
		display: flex;
		align-items: center;
		justify-content: space-between;
		color: var(--c-muted);
	}

	.capability__top :global(svg) {
		inline-size: 1.2rem;
		block-size: 1.2rem;
		color: var(--c-accent);
	}

	.capability h3 {
		font-size: clamp(1.25rem, 2vw, 1.65rem);
		font-weight: 500;
		letter-spacing: -0.03em;
	}

	.capability p {
		max-inline-size: 40ch;
		font-size: var(--t-s);
		color: var(--c-muted);
	}

	.capability__tools {
		display: flex;
		flex-wrap: wrap;
		gap: 0.35rem;
		padding-block-start: 0.3rem;
	}

	.capability__tools li {
		font-family: var(--f-mono);
		font-size: 0.56rem;
		letter-spacing: 0.03em;
		text-transform: uppercase;
		color: var(--c-muted);
	}

	.capability__tools li + li::before {
		content: "/";
		margin-inline-end: 0.35rem;
		color: var(--c-accent);
	}

	.capabilities__stack {
		display: grid;
		gap: 0.9rem;
		padding-block-start: clamp(1.5rem, 3vw, 2.2rem);
	}

	.capabilities__stack > span {
		color: var(--c-muted);
	}

	.profile__grid {
		display: grid;
		gap: clamp(2rem, 5vw, 4rem);
		align-items: start;
	}

	.profile__copy {
		display: grid;
		gap: 2rem;
	}

	.profile__principles {
		display: grid;
		border-block-start: 1px solid var(--c-line);
	}

	.profile__principles article {
		display: grid;
		gap: 0.4rem;
		padding-block: 1.1rem;
		border-block-end: 1px solid var(--c-line);
	}

	.profile__principles h3 {
		font-size: 1.05rem;
		font-weight: 500;
		letter-spacing: -0.02em;
	}

	.profile__principles p {
		max-inline-size: 52ch;
		font-size: var(--t-s);
		color: var(--c-muted);
	}

	@media (min-width: 640px) {
		.approach__notes {
			grid-template-columns: repeat(3, minmax(0, 1fr));
		}

		.approach__note {
			border-block-end: 0;
			border-inline-start: 1px solid var(--c-line);
			padding-inline: 1.1rem;
		}

		.approach__note:first-child {
			border-inline-start: 0;
			padding-inline-start: 0;
		}

		.capabilities__grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}

		.capability:nth-child(odd) {
			padding-inline-end: 1.5rem;
			border-inline-end: 1px solid var(--c-line);
		}

		.capability:nth-child(even) {
			padding-inline-start: 1.5rem;
		}
	}

	@media (min-width: 900px) {
		.profile__grid {
			grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.72fr);
			gap: clamp(3rem, 7vw, 7rem);
		}
	}
</style>
