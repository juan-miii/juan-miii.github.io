---
import { getCollection, getEntry, render } from "astro:content";

import BaseLayout from "../layouts/BaseLayout.astro";
import Button from "@portfolio/ui/button";
import Card from "@portfolio/ui/card";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import SectionTitle from "@portfolio/ui/section-title";
import Timeline from "@portfolio/ui/timeline";
import TimelineItem from "@portfolio/ui/timeline-item";

const entry = await getEntry("pages", "home");

if (!entry) {
	throw new Error("No existe el contenido de la portada.");
}

const page = entry.data;

const projects = (await getCollection("projects"))
	.filter((project) => project.data.publicationStatus === "published")
	.sort((a, b) => (a.data.featuredOrder ?? 999) - (b.data.featuredOrder ?? 999));

const cases = (await getCollection("cases"))
	.filter((item) => item.data.publicationStatus === "published")
	.sort((a, b) => a.data.title.localeCompare(b.data.title));
---

<BaseLayout title={page.title} description={page.description}>
	<Header navigation={page.navigation} />

	<Hero badge={page.hero.badge} title={page.hero.title} bio={page.hero.bio} links={page.hero.links} image="/profile.webp" />

	<section id="about" aria-labelledby="about-title">
		<SectionTitle id="about-title" eyebrow="Sobre mí">Un enfoque práctico para resolver problemas complejos</SectionTitle>
		<div class="about-grid">
			<div class="about-content">
				<p class="about-lead">{page.about.bio}</p>
				<div class="about-principles">
					<article class="principle-card">
						<h3>Claridad</h3>
						<p>Traduzco requisitos ambiguos en decisiones técnicas concretas y verificables.</p>
					</article>
					<article class="principle-card">
						<h3>Seguridad por diseño</h3>
						<p>Aplicación pragmática de principios de seguridad sin sacrificar mantenibilidad.</p>
					</article>
					<article class="principle-card">
						<h3>Entrega medible</h3>
						<p>Priorizar lo esencial, documentar decisiones y validar con hechos.</p>
					</article>
				</div>
			</div>
		</div>
	</section>

	<section id="experience" aria-labelledby="experience-title">
		<SectionTitle id="experience-title" eyebrow="Trayectoria">Experiencia profesional</SectionTitle>
		<Timeline>
			{
				page.experience.map((item) => (
					<TimelineItem title={item.title} date={item.date}>
						<p>{item.description}</p>
					</TimelineItem>
				))
			}
		</Timeline>
	</section>

	<section id="projects" aria-labelledby="projects-title">
		<SectionTitle id="projects-title" eyebrow="Selección">Proyectos destacados</SectionTitle>
		<div class="card-grid">
			{
				projects.map((project) => (
					<Card title={project.data.title} description={project.data.summary} transitionName={`project-${project.data.slug}`}>
						<div class="tag-row">
							{project.data.technologies.map((technology) => (
								<span class="tag">{technology}</span>
							))}
						</div>
						<div class="card-actions">
							{project.data.links.map((link) => (
								<Button href={link.url} variant="secondary" size="sm">
									{link.label}
								</Button>
							))}
						</div>
					</Card>
				))
			}
		</div>
	</section>

	<section id="cases" aria-labelledby="cases-title">
		<SectionTitle id="cases-title" eyebrow="Estudio de casos">Decisiones, restricciones y resultados</SectionTitle>
		<div class="card-grid">
			{
				cases.length === 0 ? (
					<Card title="Sin casos publicados">
						<p>Los casos de estudio se irán añadiendo siguiendo el proceso de anonimización y divulgación.</p>
					</Card>
				) : (
					cases.map(async (item) => {
						const { Content } = await render(item);
						return (
							<Card title={item.data.title} description={item.data.summary} transitionName={`case-${item.data.slug}`}>
								<div class="case-content">
									<Content />
								</div>
								<p class="card-meta">Divulgación: {item.data.disclosure}</p>
							</Card>
						);
					})
				)
			}
		</div>
	</section>

	<section id="this-site" aria-labelledby="site-title">
		<SectionTitle id="site-title" eyebrow="Acerca de este sitio">Arquitectura pensada para crecer</SectionTitle>
		<div class="about-grid">
			<div class="about-content">
				<p class="about-lead">{page.thisSite.description}</p>
				<div class="principles-grid">
					<article class="principle-card">
						<h3>Contenido separable</h3>
						<p>La información vive en datos validados, independiente de los componentes.</p>
					</article>
					<article class="principle-card">
						<h3>Componentes reutilizables</h3>
						<p>Sistema de UI modular con tokens semánticos para mantener coherencia.</p>
					</article>
					<article class="principle-card">
						<h3>Entrega estática</h3>
						<p>Salida pre-renderizada, rápida y con trazabilidad verificable.</p>
					</article>
					<article class="principle-card">
						<h3>Accesible y progresivo</h3>
						<p>HTML semántico, navegación por teclado y respeto a preferencias del usuario.</p>
					</article>
				</div>
			</div>
		</div>
	</section>

	<section id="contact" aria-labelledby="contact-title">
		<SectionTitle id="contact-title" eyebrow="Contacto">Hablemos</SectionTitle>
		<div class="contact-panel">
			<div class="contact-content">
				<p class="about-lead">{page.contact.description}</p>
				<div class="contact-actions">
					<Button href={`mailto:${page.contact.email}`} variant="primary">
						<svg aria-hidden="true" viewBox="0 0 20 20" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.5">
							<path d="M2.5 5.833a1.667 1.667 0 0 1 1.667-1.666h11.666a1.667 1.667 0 0 1 1.667 1.666v8.334a1.667 1.667 0 0 1-1.667 1.666H4.167a1.667 1.667 0 0 1-1.667-1.666V5.833Z" />
							<path d="M2.5 6.667 10 11.25l7.5-4.583" />
						</svg>
						Escribir correo
					</Button>
					<Button href="https://github.com/juan-miii" variant="secondary">Ver GitHub</Button>
				</div>
			</div>
		</div>
	</section>

	<Footer owner={page.footer.owner} rights={page.footer.rights} links={page.footer.links} />
</BaseLayout>

<style>
	.about-grid {
		display: grid;
		gap: var(--space-10);
	}

	.about-content {
		display: grid;
		gap: var(--space-8);
	}

	.about-lead {
		font-size: clamp(var(--text-lg), 2.5vw, var(--text-xl));
		color: var(--color-text);
		margin: 0;
		max-width: 70ch;
	}

	.about-principles,
	.principles-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
		gap: var(--space-4);
	}

	.principle-card {
		display: grid;
		gap: var(--space-2);
		padding: var(--space-5);
		background: var(--color-surface);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-xl);
		box-shadow: var(--shadow-sm);
	}

	.principle-card h3 {
		margin: 0;
		font-size: var(--text-lg);
	}

	.principle-card p {
		margin: 0;
		color: var(--color-text-muted);
	}

	.card-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(18rem, 1fr));
		gap: var(--space-4);
		align-items: stretch;
	}

	.tag-row {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-2);
	}

	.tag {
		display: inline-flex;
		align-items: center;
		padding: 0.25rem 0.625rem;
		border-radius: var(--radius-full);
		background: color-mix(in srgb, var(--color-accent) 10%, transparent);
		color: var(--color-accent);
		font-size: var(--text-xs);
		font-weight: 500;
	}

	.card-actions {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-2);
		margin-top: auto;
	}

	.case-content {
		display: grid;
		gap: var(--space-3);
	}

	.case-content :global(h2),
	.case-content :global(h3),
	.case-content :global(h4) {
		font-size: var(--text-lg);
		margin: var(--space-2) 0 0;
	}

	.card-meta {
		color: var(--color-text-subtle);
		font-size: var(--text-sm);
		margin-top: auto;
	}

	.contact-panel {
		display: grid;
		padding: clamp(var(--space-6), 6vw, var(--space-10));
		background: radial-gradient(circle at top, color-mix(in srgb, var(--color-accent) 12%, transparent), transparent 70%), var(--color-surface);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-2xl);
		box-shadow: var(--shadow-sm);
	}

	.contact-content {
		display: grid;
		gap: var(--space-6);
		max-width: 60ch;
	}

	.contact-actions {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-3);
	}
</style>
