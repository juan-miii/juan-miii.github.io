---
import { getCollection } from "astro:content";

import Discipline from "../components/sections/Discipline.astro";
import Experience from "../components/sections/Experience.astro";
import Hero from "../components/sections/Hero.astro";
import Profile from "../components/sections/Profile.astro";
import Work from "../components/sections/Work.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { getSite } from "../lib/site";

const site = await getSite();

const projects = (await getCollection("projects")).sort(
	(a, b) =>
		(a.data.featuredOrder ?? 999) - (b.data.featuredOrder ?? 999),
);
---

<BaseLayout
	title={site.title}
	description={site.description}
	bodyClass="home"
>
	<Hero
		name={site.name}
		firstName={site.hero.firstName}
		lastName={site.hero.lastName}
		intro={site.hero.intro}
		primaryAction={site.hero.primaryAction}
		secondaryAction={site.hero.secondaryAction}
	/>

	<Discipline
		approach={site.approach}
		method={site.method}
		process={site.process}
		capabilities={site.capabilities}
	/>

	<Work work={site.work} projects={projects} />

	<Experience section={site.experienceSection} />

	<Profile
		profile={site.profile}
		name={site.name}
		city={site.location.city}
	/>
</BaseLayout>
