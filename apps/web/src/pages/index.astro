---
import { getCollection, getEntry } from "astro:content";
import { Icon } from "astro-icon/components";

import ContactSection from "../components/ContactSection.astro";
import ExperienceList from "../components/ExperienceList.astro";
import Hero from "../components/Hero.astro";
import PortraitPlate from "../components/PortraitPlate.astro";
import ProjectRow from "../components/ProjectRow.astro";
import ProjectSheet from "../components/ProjectSheet.astro";
import SectionHeading from "../components/SectionHeading.astro";
import TechStack from "../components/TechStack.astro";
import BaseLayout from "../layouts/BaseLayout.astro";

const entry = await getEntry("pages", "site");
if (!entry) throw new Error("No existe el contenido del sitio.");
const site = entry.data;

const projects = (await getCollection("projects"))
	.filter((project) => project.data.publicationStatus === "published")
	.sort(
		(a, b) =>
			(a.data.featuredOrder ?? 999) - (b.data.featuredOrder ?? 999),
	);

const sheets = projects.map((project, index) => {
	const next = projects[(index + 1) % projects.length] ?? project;
	return {
		project,
		index: index + 1,
		total: projects.length,
		next: { slug: next.data.slug, title: next.data.title },
	};
});

const capabilityIcons = [
	"tabler:route",
	"tabler:shield-check",
	"tabler:terminal-2",
	"tabler:git-branch",
];
---

<BaseLayout
	title={site.title}
	description={site.description}
	bodyClass="home"
>
	<Hero
		name={site.name}
		role={site.role}
		kicker={site.hero.kicker}
		firstName={site.hero.firstName}
		lastName={site.hero.lastName}
		intro={site.hero.intro}
		primaryAction={site.hero.primaryAction}
		secondaryAction={site.hero.secondaryAction}
		portraitCaption={site.hero.portraitCaption}
		scrollCue={site.hero.scrollCue}
		location={site.location}
		availability={site.availability}
	/>

	<section id="enfoque" class="section approach" aria-labelledby="approach-title">
		<div class="shell">
			<SectionHeading
				id="approach-title"
				index={site.approach.index}
				label={site.approach.label}
				title={site.approach.title}
				body={site.approach.body}
			/>

			<dl class="approach__notes">
				{
					site.approach.notes.map((note) => (
						<div class="approach__note" data-reveal="up">
							<dt class="mono">{note.label}</dt>
							<dd>{note.value}</dd>
						</div>
					))
				}
			</dl>

			<div class="method" aria-labelledby="method-title">
				<div class="method__head">
					<span class="mono method__label">{site.method.label}</span>
					<h3 id="method-title" class="method__title">{site.method.title}</h3>
					<p class="method__body">{site.method.body}</p>
				</div>

				<ol class="method__steps">
					{
						site.process.map((step) => (
							<li data-reveal="up">
								<span class="mono">{step.index}</span>
								<h4>{step.title}</h4>
								<p>{step.description}</p>
							</li>
						))
					}
				</ol>
			</div>
		</div>
	</section>

	<section id="trabajo" class="section work" aria-labelledby="work-title">
		<div class="shell">
			<SectionHeading
				id="work-title"
				index={site.work.index}
				label={site.work.label}
				title={site.work.title}
				body={site.work.body}
			/>

			<div class="work__note" data-reveal="up">
				<span class="mono">Nota / criterio</span>
				<p>{site.work.note}</p>
			</div>

			<div class="work__list">
				{
					projects.map((project, index) => (
						<ProjectRow
							index={index + 1}
							slug={project.data.slug}
							title={project.data.title}
							summary={project.data.summary}
							role={project.data.role}
							year={project.data.year}
							status={project.data.statusLabel}
							technologies={project.data.technologies}
						/>
					))
				}
			</div>
		</div>
	</section>

	<section id="capacidades" class="section capabilities" aria-labelledby="capabilities-title">
		<div class="shell">
			<SectionHeading
				id="capabilities-title"
				index={site.capabilities.index}
				label={site.capabilities.label}
				title={site.capabilities.title}
				body={site.capabilities.body}
			/>

			<div class="capabilities__grid">
				{
					site.capabilities.items.map((item, index) => (
						<article class="capability" data-reveal="up" data-delay={String(index * 0.05)}>
							<div class="capability__top">
								<span class="mono">{String(index + 1).padStart(2, "0")}</span>
								<Icon name={capabilityIcons[index]} aria-hidden="true" />
							</div>
							<h3>{item.title}</h3>
							<p>{item.description}</p>
							<ul class="capability__tools">
								{item.tools.map((tool) => <li>{tool}</li>)}
							</ul>
						</article>
					))
				}
			</div>

			<div class="capabilities__stack" aria-labelledby="toolbox-title">
				<div class="capabilities__stack-copy">
					<span class="mono">{site.toolbox.label}</span>
					<h3 id="toolbox-title">{site.toolbox.title}</h3>
					<p>{site.toolbox.body}</p>
				</div>
				<TechStack icons={site.capabilities.stack} />
			</div>
		</div>
	</section>

	<section id="trayectoria" class="section experience" aria-labelledby="experience-title">
		<div class="shell">
			<SectionHeading
				id="experience-title"
				index={site.experienceSection.index}
				label={site.experienceSection.label}
				title={site.experienceSection.title}
				body={site.experienceSection.body}
			/>

			<ExperienceList />
		</div>
	</section>

	<section id="perfil" class="section profile" aria-labelledby="profile-title">
		<div class="shell">
			<SectionHeading
				id="profile-title"
				index={site.profile.index}
				label={site.profile.label}
				title={site.profile.title}
				body={site.profile.body}
			/>

			<div class="profile__grid">
				<div class="profile__copy">
					<div class="profile__bio" data-reveal="up">
						{site.profile.long.map((paragraph) => <p>{paragraph}</p>)}
					</div>

					<dl class="profile__details" data-reveal="up">
						{
							site.profile.details.map((detail) => (
								<div>
									<dt class="mono">{detail.label}</dt>
									<dd>{detail.value}</dd>
								</div>
							))
						}
					</dl>

					<div class="profile__principles-head">
						<span class="mono">{site.principlesSection.label}</span>
						<h3>{site.principlesSection.title}</h3>
						<p>{site.principlesSection.body}</p>
					</div>

					<div class="profile__principles">
						{
							site.profile.principles.map((principle) => (
								<article data-reveal="up">
									<h4>{principle.title}</h4>
									<p>{principle.description}</p>
								</article>
							))
						}
					</div>
				</div>

				<PortraitPlate
					alt={`Retrato de ${site.name}`}
					caption={site.location.city}
					meta="Perfil / 05"
				/>
			</div>
		</div>
	</section>

	<ContactSection
		contact={site.contact}
		email={site.email}
		github={site.github}
		location={site.location}
		availability={site.availability}
	/>

	<Fragment slot="overlays">
		{
			sheets.map((sheet) => (
				<ProjectSheet
					project={sheet.project}
					index={sheet.index}
					total={sheet.total}
					next={sheet.next}
				/>
			))
		}
	</Fragment>
</BaseLayout>

<style>
	.approach__notes {
		display: grid;
		border-block-start: 1px solid var(--c-line);
	}

	.approach__note {
		display: grid;
		gap: 0.55rem;
		padding-block: 1.2rem;
		border-block-end: 1px solid var(--c-line);
	}

	.approach__note dt {
		color: var(--c-muted);
	}

	.approach__note dd {
		font-size: clamp(1.05rem, 1.5vw, 1.3rem);
		line-height: 1.35;
		letter-spacing: -0.02em;
	}

	.method {
		display: grid;
		gap: clamp(1.8rem, 4vw, 3rem);
		margin-block-start: clamp(2.5rem, 6vw, 4.5rem);
		padding-block-start: clamp(1.5rem, 3vw, 2.2rem);
		border-block-start: 1px solid var(--c-line);
	}

	.method__head {
		display: grid;
		gap: 0.6rem;
	}

	.method__label {
		color: var(--c-muted);
	}

	.method__title {
		max-inline-size: 22ch;
		font-size: var(--t-l);
		font-weight: 500;
		line-height: 1.02;
		letter-spacing: -0.04em;
	}

	.method__body {
		max-inline-size: 58ch;
		font-size: var(--t-s);
		color: var(--c-muted);
	}

	.method__steps {
		display: grid;
		gap: 0;
		border-block-start: 1px solid var(--c-line);
	}

	.method__steps li {
		display: grid;
		gap: 0.45rem;
		padding-block: 1rem;
		border-block-end: 1px solid var(--c-line);
	}

	.method__steps .mono {
		color: var(--c-accent-ink);
	}

	.method__steps h4 {
		font-size: 1.05rem;
		font-weight: 500;
		letter-spacing: -0.02em;
	}

	.method__steps p {
		max-inline-size: 44ch;
		font-size: var(--t-s);
		color: var(--c-muted);
	}

	.work__note {
		display: grid;
		grid-template-columns: 3rem minmax(0, 1fr);
		gap: 1rem;
		max-inline-size: 72ch;
		margin-block-end: clamp(1.5rem, 4vw, 2.5rem);
		padding-block: 1rem;
		border-block-start: 1px solid var(--c-line);
	}

	.work__note > .mono {
		color: var(--c-muted);
	}

	.work__note p {
		font-size: var(--t-s);
		color: var(--c-muted);
	}

	.capabilities__grid {
		display: grid;
		border-block-start: 1px solid var(--c-line);
	}

	.capability {
		display: grid;
		align-content: start;
		gap: 0.8rem;
		padding-block: clamp(1.5rem, 3vw, 2.2rem);
		border-block-end: 1px solid var(--c-line);
	}

	.capability__top {
		display: flex;
		align-items: center;
		justify-content: space-between;
		color: var(--c-muted);
	}

	.capability__top :global(svg) {
		inline-size: 1.2rem;
		block-size: 1.2rem;
		color: var(--c-accent);
	}

	.capability h3 {
		font-size: clamp(1.25rem, 2vw, 1.65rem);
		font-weight: 500;
		letter-spacing: -0.03em;
	}

	.capability p {
		max-inline-size: 40ch;
		font-size: var(--t-s);
		color: var(--c-muted);
	}

	.capability__tools {
		display: flex;
		flex-wrap: wrap;
		gap: 0.35rem;
		padding-block-start: 0.3rem;
	}

	.capability__tools li {
		font-family: var(--f-mono);
		font-size: 0.56rem;
		letter-spacing: 0.03em;
		text-transform: uppercase;
		color: var(--c-muted);
	}

	.capability__tools li + li::before {
		content: "/";
		margin-inline-end: 0.35rem;
		color: var(--c-accent);
	}

	.capabilities__stack {
		display: grid;
		gap: 1.5rem;
		padding-block-start: clamp(2rem, 4vw, 3rem);
	}

	.capabilities__stack-copy {
		display: grid;
		gap: 0.6rem;
	}

	.capabilities__stack-copy > .mono {
		color: var(--c-muted);
	}

	.capabilities__stack-copy h3 {
		font-size: var(--t-m);
		font-weight: 500;
		letter-spacing: -0.03em;
	}

	.capabilities__stack-copy p {
		max-inline-size: 58ch;
		font-size: var(--t-s);
		color: var(--c-muted);
	}

	.profile__grid {
		display: grid;
		gap: clamp(2rem, 5vw, 4rem);
		align-items: start;
	}

	.profile__copy {
		display: grid;
		gap: clamp(1.8rem, 4vw, 2.6rem);
	}

	.profile__bio {
		display: grid;
		gap: 1rem;
		max-inline-size: 70ch;
	}

	.profile__bio p {
		font-size: var(--t-body);
		line-height: 1.65;
	}

	.profile__details {
		display: grid;
		border-block-start: 1px solid var(--c-line);
	}

	.profile__details div {
		display: grid;
		grid-template-columns: 7.5rem minmax(0, 1fr);
		gap: 1rem;
		align-items: baseline;
		padding-block: 0.7rem;
		border-block-end: 1px solid var(--c-line);
	}

	.profile__details dt {
		color: var(--c-muted);
	}

	.profile__details dd {
		font-size: var(--t-s);
	}

	.profile__principles-head {
		display: grid;
		gap: 0.5rem;
		padding-block-start: 0.5rem;
	}

	.profile__principles-head > .mono {
		color: var(--c-muted);
	}

	.profile__principles-head h3 {
		font-size: var(--t-m);
		font-weight: 500;
		letter-spacing: -0.03em;
	}

	.profile__principles-head p {
		max-inline-size: 56ch;
		font-size: var(--t-s);
		color: var(--c-muted);
	}

	.profile__principles {
		display: grid;
		border-block-start: 1px solid var(--c-line);
	}

	.profile__principles article {
		display: grid;
		gap: 0.4rem;
		padding-block: 1.1rem;
		border-block-end: 1px solid var(--c-line);
	}

	.profile__principles h4 {
		font-size: 1.05rem;
		font-weight: 500;
		letter-spacing: -0.02em;
	}

	.profile__principles p {
		max-inline-size: 52ch;
		font-size: var(--t-s);
		color: var(--c-muted);
	}

	@media (min-width: 640px) {
		.approach__notes {
			grid-template-columns: repeat(3, minmax(0, 1fr));
		}

		.approach__note {
			border-block-end: 0;
			border-inline-start: 1px solid var(--c-line);
			padding-inline: 1.1rem;
		}

		.approach__note:first-child {
			border-inline-start: 0;
			padding-inline-start: 0;
		}

		.capabilities__grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}

		.capability:nth-child(odd) {
			padding-inline-end: 1.5rem;
			border-inline-end: 1px solid var(--c-line);
		}

		.capability:nth-child(even) {
			padding-inline-start: 1.5rem;
		}
	}

	@media (min-width: 720px) {
		.method__steps {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}

		.method__steps li {
			padding-inline: 1.2rem;
			border-inline-start: 1px solid var(--c-line);
		}

		.method__steps li:nth-child(odd) {
			padding-inline-start: 0;
			border-inline-start: 0;
		}

		.method__steps li:nth-last-child(-n + 2) {
			border-block-end: 0;
		}
	}

	@media (min-width: 900px) {
		.method {
			grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
			align-items: start;
		}

		.method__steps {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}

		.capabilities__stack {
			grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
			align-items: end;
			gap: clamp(2rem, 5vw, 4rem);
		}

		.profile__grid {
			grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.72fr);
			gap: clamp(3rem, 7vw, 7rem);
		}
	}

	@media (min-width: 1100px) {
		.method__steps {
			grid-template-columns: repeat(4, minmax(0, 1fr));
		}

		.method__steps li {
			padding-inline: 1.1rem;
			border-block-end: 0;
		}

		.method__steps li:not(:first-child) {
			border-inline-start: 1px solid var(--c-line);
		}

		.method__steps li:nth-child(odd) {
			padding-inline-start: 1.1rem;
		}

		.method__steps li:first-child {
			padding-inline-start: 0;
			border-inline-start: 0;
		}
	}
</style>
