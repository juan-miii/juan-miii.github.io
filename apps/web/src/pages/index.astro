---
import { Icon } from "astro-icon/components";
import { getCollection, getEntry } from "astro:content";

//import ContactSection from "../components/ContactSection.astro";
import ExperienceList from "../components/ExperienceList.astro";
import Hero from "../components/Hero.astro";
import PortraitPlate from "../components/PortraitPlate.astro";
import ProjectRow from "../components/ProjectRow.astro";
//import ProjectSheet from "../components/ProjectSheet.astro";
import SectionHeading from "@portfolio/ui/section-heading";
import BaseLayout from "../layouts/BaseLayout.astro";

const entry = await getEntry("pages", "site");
if (!entry) throw new Error("No existe el contenido del sitio.");
const site = entry.data;

const projects = (await getCollection("projects")).sort(
	(a, b) =>
		(a.data.featuredOrder ?? 999) - (b.data.featuredOrder ?? 999),
);

// const sheets = projects.map((project, index) => {
// 	const next = projects[(index + 1) % projects.length] ?? project;
// 	return {
// 		project,
// 		index: index + 1,
// 		total: projects.length,
// 		next: { slug: next.data.slug, title: next.data.title },
// 	};
// });

const capabilityIcons = [
	"tabler:route",
	"tabler:shield-check",
	"tabler:terminal-2",
	"tabler:git-branch",
];
---

<BaseLayout
	title={site.title}
	description={site.description}
	bodyClass="home"
>
	<Hero
		name={site.name}
		firstName={site.hero.firstName}
		lastName={site.hero.lastName}
		intro={site.hero.intro}
		primaryAction={site.hero.primaryAction}
		secondaryAction={site.hero.secondaryAction}
	/>

	<section id="disciplina" class="section approach" aria-labelledby="approach-title">
		<div class="shell">
			<SectionHeading
				id="approach-title"
				index={site.approach.index}
				label={site.approach.label}
				title={site.approach.title}
				body={site.approach.body}
			/>

			<div class="method" aria-labelledby="method-title">
				<div class="method__head">
					<span class="mono method__label">{site.method.label}</span>
					<h2 id="method-title" class="method__title">{site.method.title}</h2>
					<p class="method__body">{site.method.body}</p>
				</div>

				<ol class="method__steps">
					{
						site.process.map((step) => (
							<li data-reveal="up">
								<span class="mono">{step.index}</span>
								<h4>{step.title}</h4>
								<p>{step.description}</p>
							</li>
						))
					}
				</ol>
			</div>

			<div id="capacidades" class="capabilities" aria-labelledby="capabilities-title">
				<div class="capabilities__head">
					<span class="mono capabilities__label">{site.capabilities.label}</span>
					<h2 id="capabilities-title" class="capabilities__title">
						{site.capabilities.title}
					</h2>
					<p class="capabilities__body">{site.capabilities.body}</p>
				</div>

				<div class="capabilities__grid">
					{
						site.capabilities.items.map((item, index) => (
							<article class="capability" data-reveal="up" data-delay={String(index * 0.05)}>
								<div class="capability__top">
									<h4>{item.title}</h4>
									<Icon name={capabilityIcons[index]} aria-hidden="true" />
								</div>
								<p>{item.description}</p>
								<ul class="capability__tools">
									{item.tools.map((tool) => <li>{tool}</li>)}
								</ul>
							</article>
						))
					}
				</div>
			</div>
		</div>
	</section>

	<section id="trabajo" class="section work" aria-labelledby="work-title">
		<div class="shell">
			<SectionHeading
				id="work-title"
				index={site.work.index}
				label={site.work.label}
				title={site.work.title}
				body={site.work.body}
			/>

			<div class="work__list">
				{
					projects.map((project, index) => (
						<ProjectRow
							index={index + 1}
							slug={project.data.slug}
							title={project.data.title}
							summary={project.data.summary}
							highlights={project.data.highlights}
							links={project.data.links}
							relatedOrg={project.data.relatedOrg}
							year={project.data.year}
							status={project.data.statusLabel}
							technologies={project.data.technologies}
						/>
					))
				}
			</div>
		</div>
	</section>

	<section id="trayectoria" class="section experience" aria-labelledby="experience-title">
		<div class="shell">
			<SectionHeading
				id="experience-title"
				index={site.experienceSection.index}
				label={site.experienceSection.label}
				title={site.experienceSection.title}
				body={site.experienceSection.body}
			/>

			<ExperienceList />
		</div>
	</section>

	<section id="perfil" class="section profile" aria-labelledby="profile-title">
		<div class="shell">
			<SectionHeading
				id="profile-title"
				index={site.profile.index}
				label={site.profile.label}
				title={site.profile.title}
			/>

			<div class="profile__grid">
				<div class="profile__copy">
					<div class="profile__bio" data-reveal="up">
						{site.profile.long.map((paragraph) => <p>{paragraph}</p>)}
					</div>
				</div>

				<PortraitPlate
					alt={`Retrato de ${site.name}`}
					caption={site.location.city}
					meta={`Perfil / ${site.profile.index}`}
				/>
			</div>
		</div>
	</section>

	<!-- <ContactSection contact={site.contact} email={site.email} /> -->

	<!-- <Fragment slot="overlays">
		{
			sheets.map((sheet) => (
				// <ProjectSheet
				// 	project={sheet.project}
				// 	index={sheet.index}
				// 	total={sheet.total}
				// 	next={sheet.next}
				// />
			))
		}
	</Fragment> -->
</BaseLayout>

<style>
	.method {
		display: grid;
		gap: clamp(1.8rem, 4vw, 3rem);
		margin-block-start: clamp(2.5rem, 6vw, 4.5rem);
		padding-block-start: clamp(1.5rem, 3vw, 2.2rem);
		border-block-start: 1px solid var(--c-line);
	}

	.method__head {
		display: grid;
		gap: 0.6rem;
	}

	.method__label {
		color: var(--c-muted);
	}

	.method__title {
		max-inline-size: 22ch;
		font-size: var(--t-l);
		font-weight: 500;
		line-height: 1.02;
		letter-spacing: -0.04em;
	}

	.method__body {
		max-inline-size: 58ch;
		font-size: var(--t-s);
		color: var(--c-muted);
	}

	.method__steps {
		display: grid;
		gap: 0;
		border-block-start: 1px solid var(--c-line);
	}

	.method__steps li {
		display: grid;
		gap: 0.45rem;
		padding-block: 1rem;
		border-block-end: 1px solid var(--c-line);
	}

	.method__steps .mono {
		color: var(--c-accent-ink);
	}

	.method__steps h4 {
		font-size: 1.05rem;
		font-weight: 500;
		letter-spacing: -0.02em;
	}

	.method__steps p {
		max-inline-size: 44ch;
		font-size: var(--t-s);
		color: var(--c-muted);
	}

	.capabilities {
		display: grid;
		gap: clamp(1.8rem, 4vw, 3rem);
		margin-block-start: clamp(2.5rem, 6vw, 4.5rem);
		padding-block-start: clamp(1.5rem, 3vw, 2.2rem);
		border-block-start: 1px solid var(--c-line);
	}

	.capabilities__head {
		display: grid;
		gap: 0.6rem;
	}

	.capabilities__label {
		color: var(--c-muted);
	}

	.capabilities__title {
		max-inline-size: 22ch;
		font-size: var(--t-l);
		font-weight: 500;
		line-height: 1.02;
		letter-spacing: -0.04em;
	}

	.capabilities__body {
		max-inline-size: 58ch;
		font-size: var(--t-s);
		color: var(--c-muted);
	}

	.capabilities__grid {
		display: grid;
	}

	.capability {
		display: flex;
		flex-direction: column;
		gap: 0.8rem;
		padding-block: clamp(1.5rem, 3vw, 2.2rem);
		border-block-end: 1px solid var(--c-line);
	}

	.capability__top {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 0.75rem;
	}

	.capability__top :global(svg) {
		inline-size: 1.2rem;
		block-size: 1.2rem;
		flex-shrink: 0;
		color: var(--c-accent);
	}

	.capability h4 {
		font-size: clamp(1.25rem, 2vw, 1.65rem);
		font-weight: 500;
		letter-spacing: -0.03em;
		color: var(--c-ink);
	}

	.capability p {
		max-inline-size: 40ch;
		font-size: var(--t-s);
		color: var(--c-muted);
	}

	.capability__tools {
		display: flex;
		flex-wrap: wrap;
		gap: 0.35rem;
		padding-block-start: 0.5rem;
		margin-block-start: auto; /* Clave para que todas las listas de tags queden a la misma altura */
	}

	.capability__tools li {
		font-family: var(--f-mono);
		font-size: 0.56rem;
		letter-spacing: 0.03em;
		text-transform: uppercase;
		color: var(--c-muted);
	}

	.capability__tools li + li::before {
		content: "/";
		margin-inline-end: 0.35rem;
		color: var(--c-accent);
	}

	.profile__grid {
		display: grid;
		gap: clamp(2rem, 5vw, 4rem);
		align-items: start;
	}

	.profile__copy {
		display: grid;
		gap: clamp(1.8rem, 4vw, 2.6rem);
	}

	.profile__bio {
		display: grid;
		gap: 1rem;
		max-inline-size: 70ch;
	}

	.profile__bio p {
		font-size: var(--t-body);
		line-height: 1.65;
	}

	@media (min-width: 640px) {
		.capabilities__grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}

		.capability:nth-child(odd) {
			padding-inline-end: 1.5rem;
			border-inline-end: 1px solid var(--c-line);
		}

		.capability:nth-child(even) {
			padding-inline-start: 1.5rem;
		}
	}

	@media (min-width: 720px) {
		.method__steps {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}

		.method__steps li {
			padding-inline: 1.2rem;
			border-inline-start: 1px solid var(--c-line);
		}

		.method__steps li:nth-child(odd) {
			padding-inline-start: 0;
			border-inline-start: 0;
		}

		.method__steps li:nth-last-child(-n + 2) {
			border-block-end: 0;
		}
	}

	@media (min-width: 900px) {
		.method {
			grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
			align-items: start;
		}

		.method__steps {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}

		.profile__grid {
			grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.72fr);
			gap: clamp(3rem, 7vw, 7rem);
		}
	}

	@media (min-width: 1100px) {
		.method__steps {
			grid-template-columns: repeat(4, minmax(0, 1fr));
		}

		.method__steps li {
			padding-inline: 1.1rem;
			border-block-end: 0;
		}

		.method__steps li:not(:first-child) {
			border-inline-start: 1px solid var(--c-line);
		}

		.method__steps li:nth-child(odd) {
			padding-inline-start: 1.1rem;
		}

		.method__steps li:first-child {
			padding-inline-start: 0;
			border-inline-start: 0;
		}

    .capabilities__grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }

    .capability:nth-child(n) {
      padding-inline: 1.5rem;
      border-inline-end: 1px solid var(--c-line);
    }

    .capability:first-child {
      padding-inline-start: 0;
    }

    .capability:last-child {
      padding-inline-end: 0;
      border-inline-end: 0;
    }
	}
</style>
