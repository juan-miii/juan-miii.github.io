---
import { getEntry } from "astro:content";
import { Icon } from "astro-icon/components";

import ExperienceList from "../components/ExperienceList.astro";
import PageHeader from "../components/PageHeader.astro";
import SectionHeading from "../components/SectionHeading.astro";
import TechStack from "../components/TechStack.astro";
import BaseLayout from "../layouts/BaseLayout.astro";

const entry = await getEntry("pages", "site");
if (!entry) throw new Error("No existe el contenido del sitio.");
const site = entry.data;
---

<BaseLayout
	title={`Trayectoria / ${site.name}`}
	description={site.pages.experience.description}
>
	<PageHeader
		index={site.pages.experience.index}
		label={site.pages.experience.label}
		title={site.pages.experience.title}
		description={site.pages.experience.description}
		meta={site.pages.experience.meta}
	/>

	<section class="experience-page section" aria-labelledby="roles-title">
		<div class="shell">
			<div class="experience-page__head">
				<h2 id="roles-title" class="mono">Roles</h2>
				<span class="mono experience-page__count">02 etapas</span>
			</div>
			<ExperienceList />
		</div>
	</section>

	<section class="method section" aria-labelledby="method-title">
		<div class="shell">
			<SectionHeading
				id="method-title"
				index={site.method.index}
				label={site.method.label}
				title={site.method.title}
				body={site.method.body}
			/>

			<ol class="method__steps">
				{
					site.process.map((step) => (
						<li data-reveal="up">
							<span class="mono method__index">{step.index}</span>
							<h3>{step.title}</h3>
							<p>{step.description}</p>
						</li>
					))
				}
			</ol>
		</div>
	</section>

	<section class="toolbox section" aria-labelledby="toolbox-title">
		<div class="shell">
			<SectionHeading
				id="toolbox-title"
				index={site.toolbox.index}
				label={site.toolbox.label}
				title={site.toolbox.title}
				body={site.toolbox.body}
			/>

			<div class="toolbox__grid">
				<div class="toolbox__stack">
					<span class="mono">Stack habitual</span>
					<TechStack icons={site.capabilities.stack} />
				</div>

				<div class="toolbox__note">
					<p>
						La herramienta cambia con el problema. Lo que no cambia es el
						criterio: dependencias explícitas, permisos mínimos y una salida
						que otra persona pueda reconstruir.
					</p>
					<a class="link-arrow" href="/contacto/">
						Contar un problema
						<Icon name="tabler:arrow-up-right" aria-hidden="true" />
					</a>
				</div>
			</div>
		</div>
	</section>
</BaseLayout>

<style>
	.experience-page {
		padding-block-start: clamp(2rem, 4vw, 3rem);
	}

	.experience-page__head {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		padding-block-end: 0.7rem;
	}

	.experience-page__head h2 {
		font-size: var(--t-xs);
		font-weight: 400;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		color: var(--c-muted);
	}

	.experience-page__count {
		color: var(--c-accent-ink);
	}

	.method__steps {
		display: grid;
		border-block-start: 1px solid var(--c-line);
		counter-reset: none;
	}

	.method__steps li {
		display: grid;
		gap: 0.55rem;
		align-content: start;
		padding-block: clamp(1.4rem, 3vw, 2.2rem);
		border-block-end: 1px solid var(--c-line);
	}

	.method__index {
		color: var(--c-accent-ink);
	}

	.method__steps h3 {
		font-size: clamp(1.3rem, 2.2vw, 1.8rem);
		font-weight: 500;
		letter-spacing: -0.03em;
	}

	.method__steps p {
		max-inline-size: 38ch;
		font-size: var(--t-s);
		color: var(--c-muted);
	}

	.toolbox__grid {
		display: grid;
		gap: clamp(2rem, 5vw, 4rem);
		padding-block-start: 1.2rem;
		border-block-start: 1px solid var(--c-line);
	}

	.toolbox__stack {
		display: grid;
		gap: 1rem;
		align-content: start;
	}

	.toolbox__stack > span {
		color: var(--c-muted);
	}

	.toolbox__note {
		display: grid;
		gap: 1.2rem;
		justify-items: start;
	}

	.toolbox__note p {
		max-inline-size: 42ch;
		font-size: var(--t-m);
		line-height: 1.45;
	}

	@media (min-width: 640px) {
		.method__steps {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}

		.method__steps li:nth-child(odd) {
			padding-inline-end: 1.5rem;
			border-inline-end: 1px solid var(--c-line);
		}

		.method__steps li:nth-child(even) {
			padding-inline-start: 1.5rem;
		}
	}

	@media (min-width: 900px) {
		.method__steps {
			grid-template-columns: repeat(4, minmax(0, 1fr));
		}

		.method__steps li {
			border-inline-end: 1px solid var(--c-line);
			padding-inline: 1.2rem;
		}

		.method__steps li:first-child {
			padding-inline-start: 0;
		}

		.method__steps li:last-child {
			border-inline-end: 0;
			padding-inline-end: 0;
		}

		.toolbox__grid {
			grid-template-columns: minmax(0, 1.2fr) minmax(0, 0.8fr);
		}
	}
</style>
