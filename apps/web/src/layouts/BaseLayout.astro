---
import "../styles/global.css";

interface Props {
	title: string;
	description?: string;
	canonical?: string;
	ogImage?: string;
	ogType?: string;
}

const { title, description, canonical, ogImage = "/images/og-default.svg", ogType = "website" } = Astro.props;
const canonicalUrl = canonical ?? new URL(Astro.url.pathname, Astro.site ?? "https://juan-miii.github.io").href;
---

<!doctype html>
<html lang="es">
	<head>
		<script is:inline>
			try {
				const theme = localStorage.getItem("theme") || "system";
				const dark = theme === "dark" || (theme === "system" && window.matchMedia("(prefers-color-scheme: dark)").matches);
				document.documentElement.style.colorScheme = dark ? "dark" : "light";
				document.documentElement.classList.toggle("dark", dark);
			} catch {}
		</script>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		{description && <meta name="description" content={description} />}
		<link rel="canonical" href={canonicalUrl} />
		<meta property="og:title" content={title} />
		{description && <meta property="og:description" content={description} />}
		<meta property="og:url" content={canonicalUrl} />
		<meta property="og:type" content={ogType} />
		<meta property="og:image" content={new URL(ogImage, Astro.site ?? "https://juan-miii.github.io").href} />
		<meta name="twitter:card" content="summary_large_image" />
		<title>{title}</title>
	</head>
	<body>
		<a class="skip-link" href="#main">Saltar al contenido</a>
		<main id="main">
			<slot />
		</main>
	</body>
</html>

<style is:global>
	* {
		box-sizing: border-box;
	}

	body {
		margin: 0;
		background: var(--color-bg);
		color: var(--color-text);
		font-family: var(--font-body);
		font-size: var(--text-body);
		line-height: 1.6;
	}

	@media (prefers-reduced-motion: no-preference) {
		html {
			scroll-behavior: smooth;
		}
	}

	.skip-link {
		position: absolute;
		left: -9999px;
	}

	.skip-link:focus-visible {
		position: fixed;
		inset-block-start: var(--space-4);
		inset-inline-start: var(--space-4);
		z-index: 10;
		padding: var(--space-2) var(--space-4);
		background: var(--color-surface);
		color: var(--color-text);
		border: 1px solid var(--color-border);
		border-radius: 999px;
	}

	main {
		width: min(72rem, 100%);
		margin-inline: auto;
		padding: 0 clamp(var(--space-4), 4vw, var(--space-6)) var(--space-12);
	}

	h1 {
		margin-block: 0 var(--space-3);
		font-family: var(--font-display);
		font-size: var(--text-display);
		line-height: 1.05;
		text-wrap: balance;
	}

	p {
		max-width: 65ch;
	}

	section {
		margin-block: var(--space-6);
	}
</style>
