---
import PageWrapper from "@portfolio/ui/page-wrapper";
import ThemeScript from "@portfolio/ui/theme-script";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import Loader from "../components/Loader.astro";
import Menu from "../components/Menu.astro";
import SignalTrace from "../components/SignalTrace.astro";
import { getSite } from "../lib/site";
import "../styles/global.css";

interface Props {
	title?: string;
	description?: string;
	noindex?: boolean;
	bodyClass?: string;
}

const site = await getSite();

const {
	title = site.title,
	description = site.description,
	noindex = false,
	bodyClass,
} = Astro.props;

const origin = Astro.site ?? new URL("https://juan-miii.github.io");
const canonicalUrl = new URL(Astro.url.pathname, origin).href;
const ogUrl = new URL("/og.png", origin).href;

// The home is the only navigable page.
const isHome =
	Astro.url.pathname === "/" || Astro.url.pathname === "/index.html";
const navigation = site.navigation.map((item) => ({
	...item,
	href: isHome ? item.href : `/${item.href}`,
}));
const homeHref = isHome ? "#inicio" : "/#inicio";
const contactHref = isHome ? "#contacto" : "/#contacto";

const person = {
	"@context": "https://schema.org",
	"@type": "Person",
	name: site.name,
	url: origin.href,
	jobTitle: site.role,
	description: site.description,
	sameAs: [site.github],
	address: {
		"@type": "PostalAddress",
		addressLocality: site.location.city,
		addressCountry: "ES",
	},
	knowsAbout: [
		"Arquitectura de software",
		"Seguridad aplicada",
		"Automatización",
		"Entrega continua",
	],
};
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="color-scheme" content="light dark" />
		<meta name="theme-color" content="#F2F1EC" />
		<ThemeScript />
		<script is:inline>
			document.documentElement.classList.add("js");
			// Failsafe: if the engine never finishes booting, reveal the static page.
			window.setTimeout(() => {
				if (!document.documentElement.classList.contains("is-loaded")) {
					document.documentElement.classList.remove("js");
				}
			}, 6000);
		</script>
		<title>{title}</title>
		<meta name="description" content={description} />
		<meta name="author" content={site.name} />
		<meta name="generator" content={Astro.generator} />
		{noindex && <meta name="robots" content="noindex, nofollow" />}
		<link rel="canonical" href={canonicalUrl} />
		<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
		<link
			rel="preload"
			href="/fonts/switzer-400-normal.woff2"
			as="font"
			type="font/woff2"
			crossorigin
		/>
		<link
			rel="preload"
			href="/fonts/switzer-500-normal.woff2"
			as="font"
			type="font/woff2"
			crossorigin
		/>

		<meta property="og:locale" content="es_ES" />
		<meta property="og:site_name" content={site.name} />
		<meta property="og:type" content="website" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonicalUrl} />
		<meta property="og:image" content={ogUrl} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content={`${site.name}, ${site.role}`} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogUrl} />

		<script
			type="application/ld+json"
			set:html={JSON.stringify(person)}
		/>
		<noscript>
			<style>
				#loader {
					display: none !important;
				}
				.js [data-reveal],
				.js [data-split] {
					visibility: visible !important;
				}
			</style>
		</noscript>
	</head>
	<body class:list={["page", bodyClass]}>
		<a class="skip-link" href="#main">Saltar al contenido</a>

		<Loader
			name={site.name}
			city={site.location.city}
			country={site.location.country}
		/>

		<Header
			name={site.name}
			role={site.role}
			navigation={navigation}
			homeHref={homeHref}
			contactHref={contactHref}
		/>

		<main id="main" data-trace-scope data-inert-when-menu>
			<SignalTrace />
			<PageWrapper>
				<slot />
			</PageWrapper>
		</main>

		<Footer
			name={site.name}
			navigation={navigation}
			footer={site.footer}
			homeHref={homeHref}
		/>

		<Menu navigation={navigation} links={site.footer.links} />

		<script>
			import { start } from "../engine/astro";
			import { setupMotion } from "../motion/setup";

			start(setupMotion);
		</script>
	</body>
</html>