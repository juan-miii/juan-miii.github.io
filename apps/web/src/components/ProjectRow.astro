---
import { Icon } from "astro-icon/components";
import type { ProjectEntry } from "../types";

interface Props {
	index: number;
	project: ProjectEntry["data"];
}

const { index, project } = Astro.props;

const {
	title,
	summary,
	highlights,
	links,
	relatedOrg,
	year,
	statusLabel: status,
	technologies,
} = project;

const externalLinks = links.filter((link) => link.kind !== "demo");
---

<article class="project-row" data-trace-anchor>
	<span class="project-row__index">{String(index).padStart(2, "0")}</span>

	<div class="project-row__main">
		<h3 class="project-row__title">{title}</h3>

		<p class="project-row__summary">{summary}</p>

		<p class="project-row__highlights">{highlights}</p>

		<div class="project-row__links">
			{
				externalLinks.map((link) => (
					<a href={link.url} rel="noopener" target="_blank">
						{link.label}
						<Icon name="tabler:arrow-up-right" aria-hidden="true" />
					</a>
				))
			}
		</div>

		<span class="project-row__tech">
			{technologies.map((technology) => <span>{technology}</span>)}
		</span>
	</div>

	<span class="project-row__meta">
		<span>{year}</span>
		<span>{relatedOrg}</span>
		<span>{status}</span>
	</span>
</article>

<style>
	.project-row {
		position: relative;
		display: grid;
		grid-template-columns: 2.2rem minmax(0, 1fr) auto;
		grid-template-areas:
			"index main arrow"
			"index meta meta";
		column-gap: 1rem;
		row-gap: 0.9rem;
		align-items: start;
		padding-block: clamp(1.4rem, 2.6vw, 2.1rem);
		border-block-start: 1px solid var(--c-line);
		isolation: isolate;
		overflow: hidden;
		transition: color var(--motion-base) var(--motion-easing);
	}

	.project-row:last-child {
		border-block-end: 1px solid var(--c-line);
	}

	.project-row::before {
		content: "";
		position: absolute;
		inset: 0;
		z-index: -1;
		background: var(--c-ink);
		transform: scaleY(0);
		transform-origin: bottom;
		transition: transform 420ms var(--motion-easing);
	}

	.project-row__index {
		grid-area: index;
		padding-block-start: 0.35rem;
		font-family: var(--f-mono);
		font-size: var(--t-xs);
		color: var(--c-accent-ink);
		font-variant-numeric: tabular-nums;
	}

	.project-row__main {
		grid-area: main;
		display: grid;
		gap: 0.55rem;
	}

	.project-row__title {
		margin: 0;
		font-size: clamp(1.55rem, 3vw, 2.8rem);
		font-weight: 500;
		line-height: 1;
		letter-spacing: -0.04em;
		transition: transform 420ms var(--motion-easing);
	}

	.project-row__summary {
		max-inline-size: 56ch;
		font-size: var(--t-s);
		line-height: 1.5;
		color: var(--c-muted);
		transition: color var(--motion-base) var(--motion-easing);
	}

	.project-row__highlights {
		max-inline-size: 58ch;
		font-size: var(--t-s);
		line-height: 1.45;
		color: var(--c-muted);
		transition: color var(--motion-base) var(--motion-easing);
	}

	.project-row__links {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem 1.1rem;
		padding-block-start: 0.2rem;
	}

	.project-row__links a {
		display: inline-flex;
		align-items: center;
		gap: 0.25rem;
		min-block-size: 1.5rem;
		font-family: var(--f-mono);
		font-size: 0.6rem;
		letter-spacing: 0.04em;
		text-transform: uppercase;
		color: var(--c-ink);
		text-decoration: underline;
		text-decoration-color: var(--c-line-strong);
		text-underline-offset: 0.3em;
		transition:
			color var(--motion-base) var(--motion-easing),
			text-decoration-color var(--motion-base) var(--motion-easing);
	}

	.project-row__links :global(svg) {
		inline-size: 0.75rem;
		block-size: 0.75rem;
		transition: transform var(--motion-base) var(--motion-easing);
	}

	.project-row__tech {
		display: flex;
		flex-wrap: wrap;
		gap: 0.35rem;
	}

	.project-row__tech span {
		padding: 0.18rem 0.4rem;
		border: 1px solid var(--c-line);
		font-family: var(--f-mono);
		font-size: 0.58rem;
		letter-spacing: 0.02em;
		color: var(--c-muted);
		transition:
			color var(--motion-base) var(--motion-easing),
			border-color var(--motion-base) var(--motion-easing);
	}

	.project-row__meta {
		grid-area: meta;
		display: flex;
		flex-wrap: wrap;
		gap: 0.3rem 1.2rem;
		font-family: var(--f-mono);
		font-size: 0.6rem;
		letter-spacing: 0.04em;
		text-transform: uppercase;
		color: var(--c-muted);
		transition: color var(--motion-base) var(--motion-easing);
	}

	.project-row__meta span:last-child {
		color: var(--c-accent-ink);
	}

	.project-row:is(:hover, :focus-within)::before {
		transform: scaleY(1);
		transform-origin: top;
	}

	.project-row:is(:hover, :focus-within) {
		color: var(--c-paper);
	}

	.project-row:is(:hover, :focus-within) .project-row__title {
		transform: translateX(0.3rem);
	}

	.project-row:is(:hover, :focus-within) .project-row__summary,
	.project-row:is(:hover, :focus-within) .project-row__meta,
	.project-row:is(:hover, :focus-within) .project-row__tech span,
	.project-row:is(:hover, :focus-within) .project-row__highlights {
		color: var(--c-paper);
	}

	.project-row:is(:hover, :focus-within) .project-row__tech span {
		border-color: rgb(242 241 236 / 24%);
	}

	.project-row:is(:hover, :focus-within) .project-row__meta span:last-child,
	.project-row:is(:hover, :focus-within) .project-row__links a {
		color: var(--c-accent-dark);
	}

	.project-row:is(:hover, :focus-within) .project-row__links a {
		text-decoration-color: var(--c-accent-dark);
	}

	.project-row:focus-within {
		outline-offset: -4px;
	}

	.project-row__links a:focus-visible {
		outline-color: var(--c-accent);
	}

	@media (min-width: 720px) {
		.project-row {
			grid-template-columns: 3rem minmax(0, 1fr) 10rem 2.3rem;
			grid-template-areas: "index main meta arrow";
			column-gap: 1.5rem;
			align-items: center;
		}

		.project-row__meta {
			display: grid;
			gap: 0.3rem;
			justify-items: start;
		}
	}
</style>
