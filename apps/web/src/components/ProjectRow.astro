---
import { Icon } from "astro-icon/components";

interface Props {
	index: number;
	slug: string;
	title: string;
	summary: string;
	role: string;
	year: string;
	status: string;
	technologies: string[];
}

const { index, slug, title, summary, role, year, status, technologies } =
	Astro.props;
---

<a
	class="project-row"
	href={`/proyectos/${slug}/`}
	data-trace-anchor
	data-cursor="Abrir caso"
>
	<span class="project-row__index">{String(index).padStart(2, "0")}</span>
	<div class="project-row__main">
		<h2 class="project-row__title">{title}</h2>
		<span class="project-row__summary">{summary}</span>
		<span class="project-row__tech">
			{technologies.map((technology) => <span>{technology}</span>)}
		</span>
	</div>
	<span class="project-row__meta">
		<span>{year}</span>
		<span>{role}</span>
		<span>{status}</span>
	</span>
	<span class="project-row__arrow">
		<Icon name="tabler:arrow-up-right" aria-hidden="true" />
	</span>
</a>

<style>
	.project-row {
		position: relative;
		display: grid;
		grid-template-columns: 2.2rem minmax(0, 1fr) auto;
		grid-template-areas:
			"index main arrow"
			"index meta meta";
		column-gap: 1rem;
		row-gap: 0.9rem;
		align-items: start;
		padding-block: clamp(1.4rem, 2.6vw, 2.1rem);
		border-block-start: 1px solid var(--c-line);
		isolation: isolate;
		overflow: hidden;
		transition: color var(--motion-base) var(--motion-easing);
	}

	.project-row:last-child {
		border-block-end: 1px solid var(--c-line);
	}

	.project-row::before {
		content: "";
		position: absolute;
		inset: 0;
		z-index: -1;
		background: var(--c-ink);
		transform: scaleY(0);
		transform-origin: bottom;
		transition: transform 420ms var(--motion-easing);
	}

	.project-row__index {
		grid-area: index;
		padding-block-start: 0.35rem;
		font-family: var(--f-mono);
		font-size: var(--t-xs);
		color: var(--c-accent-ink);
		font-variant-numeric: tabular-nums;
	}

	.project-row__main {
		grid-area: main;
		display: grid;
		gap: 0.55rem;
	}

	.project-row__title {
		margin: 0;
		font-size: clamp(1.55rem, 3vw, 2.8rem);
		font-weight: 500;
		line-height: 1;
		letter-spacing: -0.04em;
		transition: transform 420ms var(--motion-easing);
	}

	.project-row__summary {
		max-inline-size: 56ch;
		font-size: var(--t-s);
		line-height: 1.5;
		color: var(--c-muted);
		transition: color var(--motion-base) var(--motion-easing);
	}

	.project-row__tech {
		display: flex;
		flex-wrap: wrap;
		gap: 0.35rem;
	}

	.project-row__tech span {
		padding: 0.18rem 0.4rem;
		border: 1px solid var(--c-line);
		font-family: var(--f-mono);
		font-size: 0.58rem;
		letter-spacing: 0.02em;
		color: var(--c-muted);
		transition:
			color var(--motion-base) var(--motion-easing),
			border-color var(--motion-base) var(--motion-easing);
	}

	.project-row__meta {
		grid-area: meta;
		display: flex;
		flex-wrap: wrap;
		gap: 0.3rem 1.2rem;
		font-family: var(--f-mono);
		font-size: 0.6rem;
		letter-spacing: 0.04em;
		text-transform: uppercase;
		color: var(--c-muted);
		transition: color var(--motion-base) var(--motion-easing);
	}

	.project-row__meta span:last-child {
		color: var(--c-accent-ink);
	}

	.project-row__arrow {
		grid-area: arrow;
		display: grid;
		place-items: center;
		inline-size: 2.3rem;
		block-size: 2.3rem;
		border: 1px solid var(--c-line-strong);
		transition:
			border-color var(--motion-base) var(--motion-easing),
			background-color var(--motion-base) var(--motion-easing),
			color var(--motion-base) var(--motion-easing);
	}

	.project-row__arrow :global(svg) {
		transition: transform var(--motion-base) var(--motion-easing);
	}

	@media (hover: hover) {
		.project-row:hover::before {
			transform: scaleY(1);
			transform-origin: top;
		}

		.project-row:hover {
			color: var(--c-paper);
		}

		.project-row:hover .project-row__title {
			transform: translateX(0.3rem);
		}

		.project-row:hover .project-row__summary,
		.project-row:hover .project-row__meta,
		.project-row:hover .project-row__tech span {
			color: var(--c-muted-dark);
		}

		.project-row:hover .project-row__tech span {
			border-color: rgb(242 241 236 / 24%);
		}

		.project-row:hover .project-row__meta span:last-child {
			color: var(--c-accent-dark);
		}

		.project-row:hover .project-row__arrow {
			border-color: var(--c-accent);
			background: var(--c-accent);
			color: var(--c-paper);
		}

		.project-row:hover .project-row__arrow :global(svg) {
			transform: translate(2px, -2px);
		}
	}

	.project-row:focus-visible {
		outline-offset: -4px;
	}

	@media (min-width: 720px) {
		.project-row {
			grid-template-columns: 3rem minmax(0, 1fr) 10rem 2.3rem;
			grid-template-areas: "index main meta arrow";
			column-gap: 1.5rem;
			align-items: center;
		}

		.project-row__meta {
			display: grid;
			gap: 0.3rem;
			justify-items: start;
		}
	}
</style>
