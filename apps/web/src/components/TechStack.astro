---
import { Icon } from "astro-icon/components";

interface Props {
	icons: string[];
	compact?: boolean;
}

const { icons, compact = false } = Astro.props;

const labels: Record<string, string> = {
	astro: "Astro",
	typescript: "TypeScript",
	nodedotjs: "Node.js",
	pnpm: "pnpm",
	turborepo: "Turborepo",
	zod: "Zod",
	githubactions: "GitHub Actions",
	git: "Git",
	playwright: "Playwright",
	docker: "Docker",
	linux: "Linux",
	biome: "Biome",
};
---

<ul class:list={["stack", { "stack--compact": compact }]}>
	{
		icons.map((icon) => (
			<li>
				<Icon name={`simple-icons:${icon}`} aria-hidden="true" />
				<span>{labels[icon] ?? icon}</span>
			</li>
		))
	}
</ul>

<style>
	.stack {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem 1.1rem;
	}

	.stack li {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		font-family: var(--f-mono);
		font-size: 0.62rem;
		letter-spacing: 0.03em;
		text-transform: uppercase;
		color: var(--c-muted);
	}

	.stack :global(svg) {
		inline-size: 0.85rem;
		block-size: 0.85rem;
		color: var(--c-ink);
	}

	.stack--compact li {
		font-size: 0.56rem;
	}
</style>
