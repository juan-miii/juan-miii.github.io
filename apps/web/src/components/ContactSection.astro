---
import { Icon } from "astro-icon/components";
import Button from "@portfolio/ui/button";
import NodeLabel from "@portfolio/ui/node-label";

interface Props {
	contact: {
		index: string;
		label: string;
		title: string;
		body: string;
		emailLabel: string;
		note: string;
	};
	email: string;
}

const { contact, email } = Astro.props;
---

<section id="contacto" class="contact dark-field" aria-labelledby="contact-title">
	<div class="shell">
		<div class="contact__top">
			<NodeLabel index={contact.index} data-trace-anchor>{contact.label}</NodeLabel>
			<span class="mono contact__signal">Señal abierta</span>
		</div>

		<div class="contact__main">
			<h2 id="contact-title" class="contact__title" data-split="lines">
				{contact.title}
			</h2>

			<div class="contact__body">
				<p>{contact.body}</p>
				<a class="contact__mail" href={`mailto:${email}`} data-cursor="Escribir">
					<span>{email}</span>
					<Icon name="tabler:arrow-up-right" aria-hidden="true" />
				</a>
				<div class="contact__actions">
					<Button variant="accent" href={`mailto:${email}`}>
						{contact.emailLabel}
						<Icon name="tabler:mail" aria-hidden="true" />
					</Button>
					<span class="contact__note">{contact.note}</span>
				</div>
			</div>
		</div>
	</div>
</section>

<style>
	.contact {
		position: relative;
		padding-block: clamp(4rem, 9vw, 8rem) clamp(4.5rem, 10vw, 9rem);
		overflow: hidden;
	}

	.contact::before {
		content: "";
		position: absolute;
		inset-block-start: 0;
		inset-inline-start: 0;
		inline-size: 100%;
		block-size: 1px;
		background: var(--c-line);
	}

	.contact__top {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 0.6rem 1.5rem;
		padding-block-end: 1rem;
		border-block-end: 1px solid var(--c-line);
	}

	.contact__signal {
		color: var(--c-accent-dark);
	}

	.contact__main {
		display: grid;
		gap: clamp(2rem, 5vw, 4rem);
		padding-block: clamp(2.5rem, 6vw, 5rem);
	}

	.contact__title {
		max-inline-size: 12ch;
		font-size: clamp(4.2rem, 15vw, 14rem);
		font-weight: 500;
		line-height: 0.78;
		letter-spacing: -0.065em;
		color: var(--c-paper);
	}

	.contact__body {
		display: grid;
		gap: 1.5rem;
		max-inline-size: 48ch;
	}

	.contact__body > p {
		font-size: clamp(1.1rem, 1.5vw, 1.35rem);
		line-height: 1.45;
		color: var(--c-muted);
	}

	.contact__mail {
		display: inline-flex;
		align-items: center;
		gap: 0.6rem;
		align-self: start;
		padding-block-end: 0.25rem;
		font-family: var(--f-mono);
		font-size: clamp(0.85rem, 1.5vw, 1.15rem);
		letter-spacing: -0.01em;
		color: var(--c-paper);
		background: linear-gradient(var(--c-accent-dark) 0 0) left bottom / 0 1px no-repeat;
		transition: background-size 420ms var(--motion-easing);
	}

	.contact__mail :global(svg) {
		color: var(--c-accent-dark);
		transition: transform var(--motion-base) var(--motion-easing);
	}

	.contact__mail:hover,
	.contact__mail:focus-visible {
		background-size: 100% 1px;
	}

	.contact__mail:hover :global(svg),
	.contact__mail:focus-visible :global(svg) {
		transform: translate(3px, -3px);
	}

	.contact__actions {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 1rem 1.5rem;
	}

	.contact__note {
		font-family: var(--f-mono);
		font-size: 0.6rem;
		letter-spacing: 0.04em;
		text-transform: uppercase;
		color: var(--c-muted);
	}

	@media (min-width: 900px) {
		.contact__main {
			grid-template-columns: minmax(0, 1.25fr) minmax(0, 0.75fr);
			align-items: end;
		}
	}
</style>
