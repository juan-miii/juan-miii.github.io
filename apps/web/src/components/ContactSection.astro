---
import { Icon } from "astro-icon/components";

interface Props {
	contact: {
		index: string;
		label: string;
		title: string;
		body: string;
		emailLabel: string;
		note: string;
		topics: string[];
		guide: { title: string; description: string }[];
	};
	email: string;
	github: string;
	location: { city: string; country: string };
	availability: { label: string; note: string };
}

//const { contact, email, github, location, availability } = Astro.props;
const { contact, email } = Astro.props;
---

<section id="contacto" class="contact dark-field" aria-labelledby="contact-title">
	<div class="shell">
		<div class="contact__top">
			<span class="node-label" data-trace-anchor>
				<span class="node-label__index">{contact.index}</span>
				{contact.label}
			</span>
			<span class="mono contact__signal">Señal abierta</span>
		</div>

		<div class="contact__main">
			<h2 id="contact-title" class="contact__title" data-split="lines">
				<!--TODO: seguramente lo cambie por Contacto, más corto que Hablemos -->
				{contact.title}
			</h2>

			<div class="contact__body">
				<p>{contact.body}</p>
				<a class="contact__mail" href={`mailto:${email}`} data-cursor="Escribir">
					<span>{email}</span>
					<Icon name="tabler:arrow-up-right" aria-hidden="true" />
				</a>
				<div class="contact__actions">
					<a class="btn btn--accent" href={`mailto:${email}`}>
						{contact.emailLabel}
						<Icon name="tabler:mail" aria-hidden="true" />
					</a>
					<span class="contact__note">{contact.note}</span>
				</div>

				<!-- <div class="contact__guide">
					<span class="mono">Qué incluir</span>
					<ol>
						{
							contact.guide.map((step, index) => (
								<li>
									<span class="mono">{String(index + 1).padStart(2, "0")}</span>
									<p>
										<strong>{step.title}.</strong> {step.description}
									</p>
								</li>
							))
						}
					</ol>
				</div> -->
			</div>
		</div>

		<!-- <ul class="contact__topics">
			{
				contact.topics.map((topic, index) => (
					<li>
						<span class="mono">{String(index + 1).padStart(2, "0")}</span>
						{topic}
					</li>
				))
			}
		</ul> -->

		<!-- <div class="contact__channels">
			<a href={github} rel="me noopener" target="_blank">
				GitHub
				<Icon name="tabler:arrow-up-right" aria-hidden="true" />
			</a>
			<span class="mono">{location.city}, {location.country}</span>
			<span class="mono">{availability.label}</span>
			<span class="mono">{availability.note}</span>
		</div> -->
	</div>
</section>

<style>
	.contact {
		position: relative;
		padding-block: clamp(4rem, 9vw, 8rem) clamp(4.5rem, 10vw, 9rem);
		overflow: hidden;
	}

	.contact::before {
		content: "";
		position: absolute;
		inset-block-start: 0;
		inset-inline-start: 0;
		inline-size: 100%;
		block-size: 1px;
		background: var(--c-line);
	}

	.contact__top {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 0.6rem 1.5rem;
		padding-block-end: 1rem;
		border-block-end: 1px solid var(--c-line);
	}

	.contact__signal {
		color: var(--c-accent-dark);
	}

	.contact__main {
		display: grid;
		gap: clamp(2rem, 5vw, 4rem);
		padding-block: clamp(2.5rem, 6vw, 5rem);
	}

	/* TODO: hacer más pequeño */
	.contact__title {
		max-inline-size: 12ch;
		font-size: clamp(4.2rem, 15vw, 14rem);
		font-weight: 500;
		line-height: 0.78;
		letter-spacing: -0.065em;
		color: var(--c-paper);
	}

	.contact__body {
		display: grid;
		gap: 1.5rem;
		max-inline-size: 48ch;
	}

	.contact__body > p {
		font-size: clamp(1.1rem, 1.5vw, 1.35rem);
		line-height: 1.45;
		color: var(--c-muted);
	}

	.contact__mail {
		display: inline-flex;
		align-items: center;
		gap: 0.6rem;
		align-self: start;
		padding-block-end: 0.25rem;
		font-family: var(--f-mono);
		font-size: clamp(0.85rem, 1.5vw, 1.15rem);
		letter-spacing: -0.01em;
		color: var(--c-paper);
		background: linear-gradient(var(--c-accent-dark) 0 0) left bottom / 0 1px no-repeat;
		transition: background-size 420ms var(--motion-easing);
	}

	.contact__mail :global(svg) {
		color: var(--c-accent-dark);
		transition: transform var(--motion-base) var(--motion-easing);
	}

	.contact__mail:hover,
	.contact__mail:focus-visible {
		background-size: 100% 1px;
	}

	.contact__mail:hover :global(svg),
	.contact__mail:focus-visible :global(svg) {
		transform: translate(3px, -3px);
	}

	.contact__actions {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 1rem 1.5rem;
	}

	.contact__note {
		font-family: var(--f-mono);
		font-size: 0.6rem;
		letter-spacing: 0.04em;
		text-transform: uppercase;
		color: var(--c-muted);
	}

	.contact__guide {
		display: grid;
		gap: 0.8rem;
		padding-block-start: 1.4rem;
		border-block-start: 1px solid var(--c-line);
	}

	.contact__guide > .mono {
		color: var(--c-muted);
	}

	.contact__guide ol {
		display: grid;
		gap: 0.7rem;
	}

	.contact__guide li {
		display: grid;
		grid-template-columns: 1.5rem minmax(0, 1fr);
		gap: 0.5rem;
		align-items: baseline;
	}

	.contact__guide li .mono {
		color: var(--c-accent-dark);
	}

	.contact__guide li p {
		font-size: var(--t-s);
		line-height: 1.5;
		color: var(--c-muted);
	}

	.contact__guide strong {
		font-weight: 500;
		color: var(--c-paper);
	}

	.contact__topics {
		display: grid;
		gap: 0;
		border-block-start: 1px solid var(--c-line);
	}

	.contact__topics li {
		display: flex;
		align-items: baseline;
		gap: 0.9rem;
		padding-block: 0.7rem;
		border-block-end: 1px solid var(--c-line);
		font-size: var(--t-s);
		color: var(--c-paper);
	}

	.contact__topics .mono {
		color: var(--c-accent-dark);
	}

	.contact__channels {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 0.7rem 1.5rem;
		padding-block-start: 1rem;
		color: var(--c-muted);
	}

	.contact__channels a {
		display: inline-flex;
		align-items: center;
		gap: 0.3rem;
		min-block-size: 1.5rem;
		padding-block: 0.2rem;
		font-family: var(--f-mono);
		font-size: 0.6rem;
		letter-spacing: 0.04em;
		text-transform: uppercase;
		color: var(--c-paper);
		text-decoration: underline;
		text-decoration-color: var(--c-line-strong);
		text-underline-offset: 0.25em;
		transition: text-decoration-color var(--motion-base) var(--motion-easing);
	}

	.contact__channels a:hover,
	.contact__channels a:focus-visible {
		text-decoration-color: var(--c-accent-dark);
	}

	.contact__channels :global(svg) {
		inline-size: 0.8rem;
		block-size: 0.8rem;
		color: var(--c-accent-dark);
	}

	@media (min-width: 900px) {
		.contact__main {
			grid-template-columns: minmax(0, 1.25fr) minmax(0, 0.75fr);
			align-items: end;
		}

		.contact__topics {
			grid-template-columns: repeat(4, minmax(0, 1fr));
			border-block-end: 1px solid var(--c-line);
		}

		.contact__topics li {
			border-block-end: 0;
			border-inline-end: 1px solid var(--c-line);
			padding-inline: 1rem;
		}

		.contact__topics li:first-child {
			padding-inline-start: 0;
		}

		.contact__topics li:last-child {
			border-inline-end: 0;
			padding-inline-end: 0;
		}
	}
</style>
