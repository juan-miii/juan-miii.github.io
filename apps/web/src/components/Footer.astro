---
import { Icon } from "astro-icon/components";
import BaseFooter from "@portfolio/ui/base-footer";
import NodeLabel from "@portfolio/ui/node-label";
import type {
	FooterContent,
	NavigationItem,
} from "../types";

interface Props {
	name: string;
	navigation: NavigationItem[];
	footer: FooterContent;
	homeHref: string;
}

const { name, navigation, footer, homeHref } = Astro.props;
const year = new Date().getFullYear();
const contact = navigation.find((item) => item.href.endsWith("#contacto"));
---

<BaseFooter data-inert-when-menu>
	<section id="contacto">
		<div class="footer__top">
			<NodeLabel index={contact?.index ?? "05"} data-trace-anchor>
				{contact?.label ?? "Contacto"}
			</NodeLabel>
			<a class="footer__back" href={homeHref}>
				<span>Volver al inicio</span>
				<Icon name="tabler:arrow-up" aria-hidden="true" />
			</a>
		</div>

		<div class="footer__grid">
			<div class="footer__about">
				<p class="footer__note">{footer.note}</p>
				<p class="footer__colophon">{footer.colophon}</p>
			</div>

			<nav class="footer__nav" aria-label="Navegación del pie" data-section-nav>
				<span class="mono footer__label">Mapa</span>
				<ul>
					{
						navigation.map((item) => (
							<li>
								<a href={item.href}>
									<span class="footer__index">{item.index}</span>
									{item.label}
								</a>
							</li>
						))
					}
				</ul>
			</nav>

			<div class="footer__contact">
				<span class="mono footer__label">Conectamos</span>
				<ul class="footer__connect">
					{
						footer.links.map((link) => (
							<li>
								<a href={link.url} rel="me noopener" target="_blank">
									{link.label}
								</a>
							</li>
						))
					}
				</ul>
			</div>
		</div>

		<div class="footer__bottom">
			<span>© {year} {name}</span>
			<span>{footer.rights}</span>
			<span class="footer__built">Diseño y código propios</span>
		</div>
	</section>
</BaseFooter>

<style>
	.footer__top {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		padding-block-end: 1rem;
		border-block-end: 1px solid var(--c-line);
		color: var(--c-muted);
	}

	.footer__back {
		display: inline-flex;
		align-items: center;
		gap: 0.3rem;
		min-block-size: 1.5rem;
		padding-block: 0.15rem;
		font-size: var(--t-s);
		color: var(--c-paper);
	}

	.footer__back :global(svg) {
		transition: transform var(--motion-base) var(--motion-easing);
	}

	.footer__back:hover :global(svg),
	.footer__back:focus-visible :global(svg) {
		transform: translate(2px, -2px);
	}

	.footer__grid {
		display: grid;
		gap: 2rem;
		padding-block-start: 1.4rem;
		padding-block-end: clamp(2.2rem, 4.5vw, 3.6rem);
	}

	.footer__note {
		max-inline-size: 22ch;
		font-size: clamp(1.05rem, 1.45vw, 1.35rem);
		color: var(--c-paper);
	}

	.footer__colophon {
		max-inline-size: 34ch;
		margin-block-start: 0.6rem;
		color: var(--c-muted);
		font-size: var(--t-s);
	}

	.footer__label {
		display: block;
		margin-block-end: 0.8rem;
		color: var(--c-muted);
	}

	.footer__nav ul,
	.footer__contact ul {
		display: grid;
		gap: 0.45rem;
	}

	.footer__nav a {
		display: inline-flex;
		align-items: baseline;
		gap: 0.5rem;
		font-size: 1rem;
		color: var(--c-paper);
		background: linear-gradient(currentColor 0 0) left bottom / 0 1px no-repeat;
		transition: background-size var(--motion-base) var(--motion-easing);
	}

	.footer__nav a:hover,
	.footer__nav a:focus-visible,
	.footer__nav a.is-active {
		background-size: 100% 1px;
	}

	.footer__nav a.is-active {
		color: var(--c-accent-dark);
	}

	.footer__index {
		font-family: var(--f-mono);
		font-size: 0.58rem;
		color: var(--c-accent-dark);
	}

	.footer__contact a {
		display: inline-flex;
		align-items: center;
		min-block-size: 1.5rem;
		padding-block: 0.15rem;
		font-size: var(--t-s);
		color: var(--c-paper);
		text-decoration: underline;
		text-decoration-color: var(--c-line-strong);
		text-underline-offset: 0.25em;
		transition: text-decoration-color var(--motion-base) var(--motion-easing);
	}

	.footer__contact a:hover,
	.footer__contact a:focus-visible {
		text-decoration-color: var(--c-accent-dark);
	}

	.footer__bottom {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem 1.5rem;
		justify-content: space-between;
		padding-block-start: 1.1rem;
		border-block-start: 1px solid var(--c-line);
		font-family: var(--f-mono);
		font-size: 0.6rem;
		letter-spacing: 0.045em;
		text-transform: uppercase;
		color: var(--c-muted);
	}

	.footer__built {
		color: var(--c-paper);
	}

	@media (min-width: 720px) {
		.footer__grid {
			grid-template-columns: minmax(0, 1.4fr) minmax(0, 0.7fr) minmax(0, 1fr);
			gap: 2rem;
		}
	}

	@media (max-width: 479px) {
		.footer__bottom {
			justify-content: flex-start;
		}
	}
</style>
