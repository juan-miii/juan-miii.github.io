---
import { Icon } from "astro-icon/components";
import BaseFooter from "@portfolio/ui/base-footer";
import  NodeLabel from "@portfolio/ui/node-label";

interface NavigationItem {
	index: string;
	label: string;
	href: string;
}

interface Props {
	name: string;
	navigation: NavigationItem[];
	email: string;
	github: string;
	location: { city: string; country: string };
	footer: { note: string; colophon: string; rights: string };
	homeHref: string;
}

const { name, navigation, email, github, footer, homeHref } =
	Astro.props;
const year = new Date().getFullYear();
---

<BaseFooter data-inert-when-menu>
	<section id="contacto">
		<div class="footer__top">
			<div class="contact__top">
			<NodeLabel index="05" data-trace-anchor>Contacto</NodeLabel>
		</div>
		<a class="footer__back" href={homeHref}>
			<span>Volver al inicio</span>
			<Icon name="tabler:arrow-up" aria-hidden="true" />
		</a>
		</div>

		<div class="footer__grid">
			<div class="footer__about">
				<p class="footer__note">{footer.note}</p>
				<p class="footer__colophon">{footer.colophon}</p>
				<!-- TODO: cambioar  -->
			</div>

			<nav class="footer__nav" aria-label="Navegación del pie" data-section-nav>
				<span class="mono footer__label">Mapa</span>
				<ul>
					{
						navigation.map((item) => (
							<li>
								<a href={item.href}>
									<span class="footer__index">{item.index}</span>
									{item.label}
								</a>
							</li>
						))
					}<!-- TODO:revisar si mantener el contacto -->
				</ul>
			</nav>

			<div class="footer__contact">
				<span class="mono footer__label">Contacto</span>
				<ul>
					<li>
						<a class="contact__mail" href={`mailto:${email}`} data-cursor="Escribir">
							<span>{email}</span>
							<Icon name="tabler:arrow-up-right" aria-hidden="true" />
						</a><!--TODO: Cambiar svg por mail, gituhb, etc al principio como en mapa-->
					</li>
				</ul>
				<span class="mono footer__label">Conectamos</span>
				<ul>
					<li>
						<a href={github} rel="me noopener" target="_blank">GitHub</a>
					</li><!--TODO: Cambiar svg por mail, gituhb, etc al principio como en mapa-->
					<li>
						<a href={"https://www.linkedin.com/in/juanmiguelrs/"} rel="me noopener" target="_blank">LinkedIn</a>
					</li>
				</ul>
			</div>
		</div>

		<div class="footer__bottom">
			<span>© {year} {name}</span>
			<span>{footer.rights}</span>
			<span class="footer__built">Diseño y código propios</span>
		</div>
  </section>
</BaseFooter>

<style>
	.footer__top {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		padding-block-end: 1rem;
		border-block-end: 1px solid var(--c-line);
		color: var(--c-muted);
	}

	.footer__back {
		display: inline-flex;
		align-items: center;
		gap: 0.3rem;
		min-block-size: 1.5rem;
		padding-block: 0.15rem;
		font-size: var(--t-s);
		color: var(--c-paper);
	}

	.footer__back :global(svg) {
		transition: transform var(--motion-base) var(--motion-easing);
	}

	.footer__back:hover :global(svg),
	.footer__back:focus-visible :global(svg) {
		transform: translate(2px, -2px);
	}

	.footer__grid {
		display: grid;
		gap: 2rem;
		padding-block-start: 1.4rem;
		padding-block-end: clamp(2.2rem, 4.5vw, 3.6rem);
	}

	.footer__note {
		max-inline-size: 22ch;
		font-size: clamp(1.05rem, 1.45vw, 1.35rem);
		color: var(--c-paper);
	}

	.footer__colophon {
		max-inline-size: 34ch;
		margin-block-start: 0.6rem;
		color: var(--c-muted);
		font-size: var(--t-s);
	}

	.footer__label {
		display: block;
		margin-block-end: 0.8rem;
		color: var(--c-muted);
	}

	.footer__nav ul,
	.footer__contact ul {
		display: grid;
		gap: 0.45rem;
	}

	.footer__nav a {
		display: inline-flex;
		align-items: baseline;
		gap: 0.5rem;
		font-size: 1rem;
		color: var(--c-paper);
		background: linear-gradient(currentColor 0 0) left bottom / 0 1px no-repeat;
		transition: background-size var(--motion-base) var(--motion-easing);
	}

	.footer__nav a:hover,
	.footer__nav a:focus-visible,
	.footer__nav a.is-active {
		background-size: 100% 1px;
	}

	.footer__nav a.is-active {
		color: var(--c-accent-dark);
	}

	.footer__index {
		font-family: var(--f-mono);
		font-size: 0.58rem;
		color: var(--c-accent-dark);
	}

	.footer__contact a {
		display: inline-flex;
		align-items: center;
		min-block-size: 1.5rem;
		padding-block: 0.15rem;
		font-size: var(--t-s);
		color: var(--c-paper);
		text-decoration: underline;
		text-decoration-color: var(--c-line-strong);
		text-underline-offset: 0.25em;
		transition: text-decoration-color var(--motion-base) var(--motion-easing);
	}

	.footer__contact a:hover,
	.footer__contact a:focus-visible {
		text-decoration-color: var(--c-accent-dark);
	}

	.footer__place {
		margin-block-start: 1rem;
		color: var(--c-muted);
	}

	.footer__bottom {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem 1.5rem;
		justify-content: space-between;
		padding-block-start: 1.1rem;
		border-block-start: 1px solid var(--c-line);
		font-family: var(--f-mono);
		font-size: 0.6rem;
		letter-spacing: 0.045em;
		text-transform: uppercase;
		color: var(--c-muted);
	}

	.footer__built {
		color: var(--c-paper);
	}

	@media (min-width: 720px) {
		.footer__grid {
			grid-template-columns: minmax(0, 1.4fr) minmax(0, 0.7fr) minmax(0, 1fr);
			gap: 2rem;
		}
	}

	@media (max-width: 479px) {
		.footer__bottom {
			justify-content: flex-start;
		}
	}


	.contact__mail {
		display: inline-flex;
		align-items: center;
		gap: 0.6rem;
		align-self: start;
		padding-block-end: 0.25rem;
		font-family: var(--f-mono);
		font-size: clamp(0.85rem, 1.5vw, 1.15rem);
		letter-spacing: -0.01em;
		color: var(--c-paper);
		background: linear-gradient(var(--c-accent-dark) 0 0) left bottom / 0 1px no-repeat;
		transition: background-size 420ms var(--motion-easing);
	}

	.contact__mail :global(svg) { /* TODO Cambiar svg por mail, gituhb, etc al principio como en mapa*/
		color: var(--c-accent-dark);
		transition: transform var(--motion-base) var(--motion-easing);
	}


	.contact__mail:hover :global(svg),
	.contact__mail:focus-visible :global(svg) {
		transform: translate(3px, -3px);
	}
</style>
