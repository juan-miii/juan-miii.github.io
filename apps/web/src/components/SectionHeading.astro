---
interface Props {
	id: string;
	index: string;
	label: string;
	title: string;
	body?: string;
}

const { id, index, label, title, body } = Astro.props;
---

<header class="section-head">
	<div class="section-head__label">
		<span class="node-label" data-trace-anchor>
			<span class="node-label__index">{index}</span>
			{label !== title && label}
		</span>
	</div>
	<h2 id={id} class="section-head__title" data-split="lines">{title}</h2>
	{body && <p class="section-head__body">{body}</p>}
</header>

<style>
	.section-head {
		display: grid;
		grid-template-columns: repeat(12, minmax(0, 1fr));
		column-gap: var(--gutter);
		row-gap: clamp(1.2rem, 2.5vw, 2rem);
		align-items: start;
		margin-block-end: clamp(2.5rem, 6vw, 5rem);
	}

	.section-head__label {
		grid-column: 1 / -1;
	}

	.section-head__title {
		grid-column: 1 / -1;
		max-inline-size: 21ch;
		font-size: var(--t-xl);
		font-weight: 500;
		line-height: 0.98;
		letter-spacing: -0.045em;
	}

	.section-head__body {
		grid-column: 1 / -1;
		max-inline-size: 46ch;
		font-size: var(--t-body);
		color: var(--c-muted);
	}

	@media (min-width: 900px) {
		.section-head__label {
			grid-column: 1 / 3;
			padding-block-start: 0.35rem;
		}

		.section-head__title {
			grid-column: 3 / 11;
		}

		.section-head__body {
			grid-column: 3 / 8;
		}
	}
</style>
