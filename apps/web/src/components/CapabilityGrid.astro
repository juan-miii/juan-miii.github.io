---
import { Icon } from "astro-icon/components";
import type { Capabilities } from "../types";

interface Props {
	capabilities: Capabilities;
}

const { capabilities } = Astro.props;

const capabilityIcons = [
	"tabler:route",
	"tabler:shield-check",
	"tabler:terminal-2",
	"tabler:git-branch",
];
---

<div id="capacidades" class="capabilities" aria-labelledby="capabilities-title">
	<div class="capabilities__head">
		<span class="mono capabilities__label">{capabilities.label}</span>
		<h2 id="capabilities-title" class="capabilities__title">
			{capabilities.title}
		</h2>
		<p class="capabilities__body">{capabilities.body}</p>
	</div>

	<div class="capabilities__grid">
		{
			capabilities.items.map((item, index) => (
				<article
					class="capability"
					data-reveal="up"
					data-delay={String(index * 0.05)}
				>
					<div class="capability__top">
						<h3>{item.title}</h3>
						<Icon name={capabilityIcons[index]} aria-hidden="true" />
					</div>
					<p>{item.description}</p>
					<ul class="capability__tools">
						{item.tools.map((tool) => (
							<li>{tool}</li>
						))}
					</ul>
				</article>
			))
		}
	</div>
</div>

<style>
	.capabilities {
		display: grid;
		gap: clamp(1.8rem, 4vw, 3rem);
		margin-block-start: clamp(2.5rem, 6vw, 4.5rem);
		padding-block-start: clamp(1.5rem, 3vw, 2.2rem);
		border-block-start: 1px solid var(--c-line);
	}

	.capabilities__head {
		display: grid;
		gap: 0.6rem;
	}

	.capabilities__label {
		color: var(--c-muted);
	}

	.capabilities__title {
		max-inline-size: 22ch;
		font-size: var(--t-l);
		font-weight: 500;
		line-height: 1.02;
		letter-spacing: -0.04em;
	}

	.capabilities__body {
		max-inline-size: 58ch;
		font-size: var(--t-s);
		color: var(--c-muted);
	}

	.capabilities__grid {
		display: grid;
	}

	.capability {
		display: flex;
		flex-direction: column;
		gap: 0.8rem;
		padding-block: clamp(1.5rem, 3vw, 2.2rem);
		border-block-end: 1px solid var(--c-line);
	}

	.capability__top {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 0.75rem;
	}

	.capability__top :global(svg) {
		inline-size: 1.2rem;
		block-size: 1.2rem;
		flex-shrink: 0;
		color: var(--c-accent);
	}

	.capability h3 {
		font-size: clamp(1.25rem, 2vw, 1.65rem);
		font-weight: 500;
		letter-spacing: -0.03em;
		color: var(--c-ink);
	}

	.capability p {
		max-inline-size: 40ch;
		font-size: var(--t-s);
		color: var(--c-muted);
	}

	.capability__tools {
		display: flex;
		flex-wrap: wrap;
		gap: 0.35rem;
		padding-block-start: 0.5rem;
		margin-block-start: auto;
	}

	.capability__tools li {
		font-family: var(--f-mono);
		font-size: 0.56rem;
		letter-spacing: 0.03em;
		text-transform: uppercase;
		color: var(--c-muted);
	}

	.capability__tools li:not(:last-child)::after {
		content: "/";
		margin-inline-start: 0.35rem;
		color: var(--c-accent);
	}

	@media (min-width: 640px) {
		.capabilities__grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}

		.capability:nth-child(odd) {
			padding-inline-end: 1.5rem;
			border-inline-end: 1px solid var(--c-line);
		}

		.capability:nth-child(even) {
			padding-inline-start: 1.5rem;
		}
	}

	@media (min-width: 1100px) {
		.capabilities__grid {
			grid-template-columns: repeat(4, minmax(0, 1fr));
		}

		.capability:nth-child(n) {
			padding-inline: 1.5rem;
			border-inline-end: 1px solid var(--c-line);
		}

		.capability:first-child {
			padding-inline-start: 0;
		}

		.capability:last-child {
			padding-inline-end: 0;
			border-inline-end: 0;
		}
	}
</style>
