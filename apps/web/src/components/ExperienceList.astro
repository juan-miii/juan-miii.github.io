---
import { Icon } from "astro-icon/components";
import { getCollection, getEntry } from "astro:content";

const experience = await getCollection("experience");
const roles = await Promise.all(
	experience.map(async (role) => {
		const organization = await getEntry(
			"organizations",
			role.data.organizationId,
		);
		return {
			...role.data,
			organization: organization?.data ?? null,
		};
	}),
);

roles.sort((a, b) => {
	if (a.current !== b.current) return a.current ? -1 : 1;
	return b.startDate.localeCompare(a.startDate);
});

const formatPeriod = (role: (typeof roles)[number]) =>
	role.current
		? `${role.startDate}-actualidad`
		: `${role.startDate}-${role.endDate ?? role.startDate}`;
---

<div class="roles">
	{
		roles.map((role, index) => (
			<article class="role" data-trace-anchor>
				<span class="role__index" aria-hidden="true">
					{String(index + 1).padStart(2, "0")}
				</span>

				<div class="role__main">
					<h3 class="role__org">
						{role.organization?.url ? (
							<a
								href={role.organization.url}
								rel="noopener"
								target="_blank"
							>
								{role.organization.name}
								<Icon name="tabler:arrow-up-right" aria-hidden="true" />
							</a>
						) : (
							role.organization?.name
						)}
					</h3>
					<p class="role__role">
						<em>{role.role} ({formatPeriod(role)})</em>
					</p>
					<p class="role__summary">{role.summary}</p>
					<ul class="role__contributions">
						{role.contributions.map((contribution) => (
							<li>{contribution}</li>
						))}
					</ul>
				</div>

				<div class="role__meta">
					<span>{role.location}</span>
					<span class:list={["role__status", { "is-current": role.current }]}>
						{role.current ? "Puesto actual" : "Finalizada"}
					</span>
				</div>
			</article>
		))
	}
</div>

<style>
	.roles {
		display: grid;
	}

	.role {
		display: grid;
		grid-template-columns: 2.4rem minmax(0, 1fr);
		column-gap: 1rem;
		row-gap: 0.9rem;
		padding-block: clamp(1.6rem, 3vw, 2.4rem);
		border-block-start: 1px solid var(--c-line);
	}

	.role:last-child {
		border-block-end: 1px solid var(--c-line);
	}

	.role__index {
		padding-block-start: 0.3rem;
		font-family: var(--f-mono);
		font-size: var(--t-xs);
		color: var(--c-accent-ink);
	}

	.role__main {
		display: grid;
		gap: 0.6rem;
	}

	.role__org {
		font-size: clamp(1.4rem, 2.4vw, 2rem);
		font-weight: 500;
		letter-spacing: -0.035em;
	}

	.role__org a {
		display: inline-flex;
		align-items: center;
		gap: 0.3rem;
	}

	.role__org :global(svg) {
		inline-size: 0.85rem;
		block-size: 0.85rem;
		color: var(--c-accent-ink);
		transition: transform var(--motion-base) var(--motion-easing);
	}

	.role__org a:hover :global(svg),
	.role__org a:focus-visible :global(svg) {
		transform: translate(2px, -2px);
	}

	.role__role {
		max-inline-size: 58ch;
		font-size: var(--t-body);
		line-height: 1.45;
		color: var(--c-muted);
	}

	.role__role em {
		font-style: italic;
	}

	.role__summary {
		max-inline-size: 62ch;
		font-size: var(--t-s);
		color: var(--c-muted);
	}

	.role__contributions {
		display: grid;
		gap: 0.25rem;
		max-inline-size: 64ch;
		padding-block-start: 0.2rem;
	}

	.role__contributions li {
		display: grid;
		grid-template-columns: 0.7rem minmax(0, 1fr);
		gap: 0.4rem;
		font-size: var(--t-s);
		line-height: 1.45;
		color: var(--c-muted);
	}

	.role__contributions li::before {
		content: "";
		inline-size: 0.45rem;
		block-size: 1px;
		margin-block-start: 0.65em;
		background: var(--c-accent);
	}

	.role__meta {
		grid-column: 2;
		display: flex;
		flex-wrap: wrap;
		gap: 0.3rem 1.2rem;
		font-family: var(--f-mono);
		font-size: 0.6rem;
		letter-spacing: 0.04em;
		text-transform: uppercase;
		color: var(--c-muted);
	}

	.role__status.is-current {
		color: var(--c-accent-ink);
	}

	@media (min-width: 900px) {
		.role {
			grid-template-columns: 3rem minmax(0, 1fr) 12rem;
			column-gap: 1.5rem;
			align-items: start;
		}

		.role__meta {
			grid-column: 3;
			display: grid;
			justify-items: start;
			gap: 0.3rem;
			text-align: start;
		}
	}
</style>
