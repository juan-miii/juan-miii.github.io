---
import { Icon } from "astro-icon/components";
import { getCollection, getEntry } from "astro:content";

interface Props {
	compact?: boolean;
}

const { compact = false } = Astro.props;

const experience = await getCollection("experience");
const roles = await Promise.all(
	experience.map(async (role) => {
		const organization = await getEntry(
			"organizations",
			role.data.organizationId,
		);
		return {
			...role.data,
			organization: organization?.data ?? null,
		};
	}),
);

roles.sort((a, b) => {
	if (a.current !== b.current) return a.current ? -1 : 1;
	return b.startDate.localeCompare(a.startDate);
});
---

<div class:list={["roles", { "roles--compact": compact }]}>
	{
		roles.map((role, index) => (
			<article class="role" data-trace-anchor>
				<span class="role__index" aria-hidden="true">
					{String(index + 1).padStart(2, "0")}
				</span>

				<div class="role__main">
					<div class="role__top">
						<h3>{role.role}</h3>
						<span class="role__org">
							{role.organization?.url ? (
								<a
									href={role.organization.url}
									rel="noopener"
									target="_blank"
								>
									{role.organization.name}
									<Icon name="tabler:arrow-up-right" aria-hidden="true" />
								</a>
							) : (
								role.organization?.name
							)}
						</span>
					</div>
					<p class="role__summary">{role.summary}</p>
					{!compact && (
						<ul class="role__contributions">
							{role.contributions.map((contribution) => (
								<li>{contribution}</li>
							))}
						</ul>
					)}
				</div>

				<div class="role__meta">
					<span>
						{role.current
							? `${role.startDate} / actualidad`
							: `${role.startDate} / ${role.endDate}`}
					</span>
					<span>{role.location}</span>
					<span class:list={["role__status", { "is-current": role.current }]}>
						{role.current ? "En curso" : "Finalizada"}
					</span>
				</div>
			</article>
		))
	}
</div>

<style>
	.roles {
		display: grid;
	}

	.role {
		display: grid;
		grid-template-columns: 2.4rem minmax(0, 1fr);
		column-gap: 1rem;
		row-gap: 0.9rem;
		padding-block: clamp(1.6rem, 3vw, 2.4rem);
		border-block-start: 1px solid var(--c-line);
	}

	.role:last-child {
		border-block-end: 1px solid var(--c-line);
	}

	.role__index {
		padding-block-start: 0.3rem;
		font-family: var(--f-mono);
		font-size: var(--t-xs);
		color: var(--c-accent-ink);
	}

	.role__main {
		display: grid;
		gap: 0.7rem;
	}

	.role__top {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		gap: 0.4rem 1rem;
	}

	.role__top h3 {
		font-size: clamp(1.4rem, 2.4vw, 2rem);
		font-weight: 500;
		letter-spacing: -0.035em;
	}

	.role__org {
		font-family: var(--f-mono);
		font-size: 0.62rem;
		letter-spacing: 0.04em;
		text-transform: uppercase;
		color: var(--c-muted);
	}

	.role__org a {
		display: inline-flex;
		align-items: center;
		gap: 0.2rem;
		min-block-size: 1.5rem;
		margin-block: -0.3rem;
		padding-block: 0.3rem;
	}

	.role__org :global(svg) {
		inline-size: 0.75rem;
		block-size: 0.75rem;
	}

	.role__summary {
		max-inline-size: 58ch;
		font-size: var(--t-body);
		color: var(--c-muted);
	}

	.role__contributions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.35rem;
	}

	.role__contributions li {
		padding: 0.2rem 0.45rem;
		border: 1px solid var(--c-line);
		font-family: var(--f-mono);
		font-size: 0.58rem;
		letter-spacing: 0.02em;
		color: var(--c-muted);
	}

	.role__meta {
		grid-column: 2;
		display: flex;
		flex-wrap: wrap;
		gap: 0.3rem 1.2rem;
		font-family: var(--f-mono);
		font-size: 0.6rem;
		letter-spacing: 0.04em;
		text-transform: uppercase;
		color: var(--c-muted);
	}

	.role__status.is-current {
		color: var(--c-accent-ink);
	}

	@media (min-width: 900px) {
		.role {
			grid-template-columns: 3rem minmax(0, 1fr) 12rem;
			column-gap: 1.5rem;
			align-items: start;
		}

		.role__meta {
			grid-column: 3;
			display: grid;
			justify-items: start;
			gap: 0.3rem;
			text-align: start;
		}
	}
</style>
