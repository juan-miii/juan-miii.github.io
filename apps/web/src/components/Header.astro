---
import { Icon } from "astro-icon/components";
import ThemeToggle from "@portfolio/ui/theme-toggle";
import type { NavigationItem } from "../types";

interface Props {
	name: string;
	role: string;
	navigation: NavigationItem[];
	homeHref: string;
	contactHref: string;
}

const { name, role, navigation, homeHref, contactHref } =
	Astro.props;
---

<header class="site-header" data-inert-when-menu>
	<div class="header shell">
		<a class="brand" href={homeHref}>
			<span class="brand__mark" aria-hidden="true">
				<span>JM</span>
			</span>
			<span class="brand__text">
				<span class="brand__name">{name}</span>
				<span class="brand__role">{role}</span>
			</span>
			<span class="sr-only">Inicio</span>
		</a>

		<nav class="nav" aria-label="Navegación principal" data-section-nav>
			<ul class="nav__list">
				{
					navigation.map((item) => (
						<li>
							<a class="nav__link" href={item.href}>
								<span class="nav__index">{item.index}</span>
								<span class="nav__label">{item.label}</span>
							</a>
						</li>
					))
				}
			</ul>
		</nav>

		<div class="header__end">
			<a class="header__contact" href={contactHref}>
				<span>Contacto</span>
				<Icon name="tabler:arrow-down" aria-hidden="true" />
			</a>
			<ThemeToggle />
			<button
				class="menu-toggle"
				type="button"
				data-menu-toggle
				aria-expanded="false"
				aria-controls="site-menu"
				aria-label="Abrir menú"
			>
				<span class="menu-toggle__label">Menú</span>
				<span class="menu-toggle__lines" aria-hidden="true">
					<span></span>
					<span></span>
				</span>
			</button>
		</div>
	</div>
</header>

<style>
	.site-header {
		position: sticky;
		top: 0;
		z-index: var(--z-header);
		background: color-mix(in srgb, var(--c-ground) 94%, transparent);
		border-block-end: 1px solid var(--c-line);
	}

	.header {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: var(--s-4);
		min-block-size: var(--header-h);
	}

	.brand {
		display: inline-flex;
		align-items: center;
		gap: 0.7rem;
		flex-shrink: 0;
	}

	.brand__mark {
		display: grid;
		place-items: center;
		inline-size: 2rem;
		block-size: 2rem;
		border: 1px solid var(--c-ink);
		font-family: var(--f-mono);
		font-size: 0.65rem;
		font-weight: 500;
		letter-spacing: 0.04em;
		transition:
			background-color var(--motion-base) var(--motion-easing),
			color var(--motion-base) var(--motion-easing);
	}

	.brand:hover .brand__mark,
	.brand:focus-visible .brand__mark {
		background: var(--c-ink);
		color: var(--c-ground);
	}

	.brand__text {
		display: grid;
		gap: 0.05rem;
		line-height: 1.1;
	}

	.brand__name {
		font-size: 0.9rem;
		font-weight: 500;
		letter-spacing: -0.02em;
	}

	.brand__role {
		font-family: var(--f-mono);
		font-size: 0.56rem;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		color: var(--c-muted);
	}

	.nav {
		display: none;
	}

	.nav__list {
		display: flex;
		align-items: center;
		gap: clamp(0.9rem, 1.6vw, 1.7rem);
	}

	.nav__link {
		position: relative;
		display: inline-flex;
		align-items: baseline;
		gap: 0.4rem;
		padding-block: 0.35rem;
		font-size: 0.82rem;
		color: var(--c-muted);
		transition: color var(--motion-base) var(--motion-easing);
	}

	.nav__link::after {
		content: "";
		position: absolute;
		inset-inline: 0;
		inset-block-end: 0;
		block-size: 1px;
		background: currentColor;
		transform: scaleX(0);
		transform-origin: right;
		transition: transform var(--motion-base) var(--motion-easing);
	}

	.nav__link:hover,
	.nav__link:focus-visible,
	.nav__link.is-active {
		color: var(--c-ink);
	}

	.nav__link:hover::after,
	.nav__link:focus-visible::after,
	.nav__link.is-active::after {
		transform: scaleX(1);
		transform-origin: left;
	}

	.nav__index {
		font-family: var(--f-mono);
		font-size: 0.56rem;
		color: var(--c-accent-ink);
		letter-spacing: 0.02em;
	}

	.header__end {
		display: flex;
		align-items: center;
		gap: 1rem;
	}

	.header__contact {
		display: none;
		align-items: center;
		gap: 0.3rem;
		min-block-size: 1.5rem;
		padding-block: 0.25rem;
		font-size: 0.82rem;
		font-weight: 500;
	}

	.header__contact :global(svg) {
		transition: transform var(--motion-base) var(--motion-easing);
	}

	.header__contact:hover :global(svg),
	.header__contact:focus-visible :global(svg) {
		transform: translate(2px, -2px);
	}

	.menu-toggle {
		display: inline-flex;
		align-items: center;
		gap: 0.55rem;
		padding: 0.45rem 0 0.45rem 0.6rem;
		font-family: var(--f-mono);
		font-size: 0.62rem;
		letter-spacing: 0.06em;
		text-transform: uppercase;
	}

	.menu-toggle__lines {
		display: grid;
		gap: 4px;
		inline-size: 1rem;
	}

	.menu-toggle__lines span {
		display: block;
		block-size: 1px;
		background: currentColor;
		transition: transform var(--motion-base) var(--motion-easing);
	}

	.menu-toggle[aria-expanded="true"] .menu-toggle__lines span:first-child {
		transform: translateY(2.5px) rotate(45deg);
	}

	.menu-toggle[aria-expanded="true"] .menu-toggle__lines span:last-child {
		transform: translateY(-2.5px) rotate(-45deg);
	}

	@media (min-width: 1024px) {
		.nav {
			display: block;
		}

		.menu-toggle {
			display: none;
		}
	}

	@media (min-width: 1100px) {
		.header__contact {
			display: inline-flex;
		}
	}

	@media (max-width: 479px) {
		.brand__role {
			display: none;
		}
	}

	@media (max-width: 360px) {
		.brand__text {
			display: none;
		}
	}
</style>
