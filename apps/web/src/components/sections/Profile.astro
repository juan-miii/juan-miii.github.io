---
import SectionHeading from "@portfolio/ui/section-heading";
import PortraitPlate from "../PortraitPlate.astro";
import type { ProfileContent } from "../../types";

interface Props {
	profile: ProfileContent;
	name: string;
	city: string;
}

const { profile, name, city } = Astro.props;
---

<section id="perfil" class="section profile" aria-labelledby="profile-title">
	<div class="shell">
		<SectionHeading
			id="profile-title"
			index={profile.index}
			label={profile.label}
			title={profile.title}
		/>

		<div class="profile__grid">
			<div class="profile__copy">
				<div class="profile__bio" data-reveal="up">
					{profile.long.map((paragraph) => <p>{paragraph}</p>)}
				</div>
			</div>

			<PortraitPlate
				alt={`Retrato de ${name}`}
				caption={city}
				meta={`Perfil / ${profile.index}`}
			/>
		</div>
	</div>
</section>

<style>
	.profile__grid {
		display: grid;
		gap: clamp(2rem, 5vw, 4rem);
		align-items: start;
	}

	.profile__copy {
		display: grid;
		gap: clamp(1.8rem, 4vw, 2.6rem);
	}

	.profile__bio {
		display: grid;
		gap: 1rem;
		max-inline-size: 70ch;
	}

	.profile__bio p {
		font-size: var(--t-body);
		line-height: 1.65;
	}

	@media (min-width: 900px) {
		.profile__grid {
			grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.72fr);
			gap: clamp(3rem, 7vw, 7rem);
		}
	}
</style>
