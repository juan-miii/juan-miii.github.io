---
interface Props {
	index: string;
	label: string;
	title: string;
	description: string;
	meta: string;
}

const { index, label, title, description, meta } = Astro.props;
---

<header class="page-hero">
	<div class="shell">
		<div class="page-hero__top">
			<span class="node-label" data-trace-anchor>
				<span class="node-label__index">{index}</span>
				{label}
			</span>
			<span class="mono page-hero__meta">{meta}</span>
		</div>

		<div class="page-hero__main">
			<h1 class="page-hero__title" data-split="lines">{title}</h1>
			<p class="page-hero__description" data-reveal="up" data-delay="0.2">{description}</p>
		</div>
	</div>
</header>

<style>
	.page-hero {
		padding-block: clamp(2.5rem, 6vw, 4rem) clamp(2.5rem, 5vw, 4.5rem);
		border-block-end: 1px solid var(--c-line);
	}

	.page-hero__top {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 0.6rem 1.5rem;
		padding-block-end: 1rem;
		border-block-end: 1px solid var(--c-line);
	}

	.page-hero__meta {
		color: var(--c-muted);
	}

	.page-hero__main {
		display: grid;
		gap: clamp(1.4rem, 3vw, 2.4rem);
		padding-block-start: clamp(2.5rem, 6vw, 5rem);
	}

	.page-hero__title {
		font-size: var(--t-display);
		font-weight: 500;
		line-height: 0.9;
		letter-spacing: -0.05em;
		max-inline-size: 16ch;
	}

	.page-hero__description {
		max-inline-size: 52ch;
		font-size: var(--t-m);
		line-height: 1.45;
		color: var(--c-muted);
	}

	@media (min-width: 900px) {
		.page-hero__main {
			grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.6fr);
			align-items: end;
			gap: 3rem;
		}

		.page-hero__description {
			justify-self: end;
		}
	}
</style>
