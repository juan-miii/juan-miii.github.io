---
interface LinkItem {
	label: string;
	href: string;
}

interface Props {
	badge: string;
	title: string;
	bio: string;
	links: LinkItem[];
	image?: string;
	imageAlt?: string;
}

const { badge, title, bio, links, image, imageAlt = "Retrato profesional" } = Astro.props;
---

<section id="hero" class="hero" aria-labelledby="hero-title">
	<div class="hero-content">
		<div class="hero-main">
			<div class="hero-badge">
				<span class="badge-dot"></span>
				<span>{badge}</span>
			</div>
			<h1 id="hero-title" class="hero-title">{title}</h1>
			<p class="hero-bio" set:html={bio} />
			<ul class="hero-links">
				{
					links.map((link, index) => (
						<li>
							<a class:list={["hero-link", index === 0 ? "hero-link-primary" : "hero-link-secondary"]} href={link.href}>
								{link.label}
								<svg aria-hidden="true" viewBox="0 0 16 16" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.5">
									<path d="M6 12L10 8L6 4" stroke-linecap="round" stroke-linejoin="round" />
								</svg>
							</a>
						</li>
					))
				}
			</ul>
		</div>
		{
			image && (
				<div class="hero-media">
					<div class="hero-image-frame">
						<img class="hero-image" src={image} alt={imageAlt} width="320" height="320" loading="eager" />
					</div>
				</div>
			)
		}
	</div>
</section>

<style>
	.hero {
		padding: var(--space-20) 0 var(--space-16);
		border-top: none;
	}

	.hero-content {
		display: grid;
		gap: var(--space-12);
		align-items: center;
	}

	@media (min-width: 1024px) {
		.hero-content {
			grid-template-columns: 1.2fr 0.8fr;
			gap: var(--space-16);
		}
	}

	.hero-main {
		display: flex;
		flex-direction: column;
		gap: var(--space-6);
	}

	.hero-badge {
		display: inline-flex;
		align-items: center;
		gap: var(--space-2);
		padding: 0.375rem 0.875rem;
		background: var(--color-surface);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-full);
		font-size: var(--text-sm);
		color: var(--color-text-muted);
		width: fit-content;
		box-shadow: var(--shadow-sm);
	}

	.badge-dot {
		width: 0.375rem;
		height: 0.375rem;
		border-radius: 50%;
		background: var(--color-accent);
		box-shadow: 0 0 0 6px color-mix(in srgb, var(--color-accent) 12%, transparent);
	}

	.hero-title {
		margin: 0;
	}

	.hero-bio {
		font-size: clamp(var(--text-lg), 2vw, var(--text-xl));
		color: var(--color-text-muted);
		margin: 0;
		max-width: 58ch;
	}

	.hero-bio :global(strong) {
		color: var(--color-text);
		font-weight: 600;
	}

	.hero-links {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-3);
		list-style: none;
		margin: 0;
		padding: 0;
	}

	.hero-link {
		display: inline-flex;
		align-items: center;
		gap: var(--space-2);
		padding: 0.625rem 1.25rem;
		border-radius: var(--radius-full);
		text-decoration: none;
		font-weight: 500;
		font-size: var(--text-sm);
		transition: all var(--motion-base) var(--motion-easing);
	}

	.hero-link svg {
		transition: transform var(--motion-base) var(--motion-easing);
	}

	.hero-link:hover svg,
	.hero-link:focus-visible svg {
		transform: translateX(4px);
	}

	.hero-link-primary {
		background: var(--color-text);
		color: var(--color-text-inverse);
		box-shadow: var(--shadow-md);
	}

	.hero-link-primary:hover,
	.hero-link-primary:focus-visible {
		background: color-mix(in srgb, var(--color-text) 90%, var(--color-accent));
	}

	.hero-link-secondary {
		background: var(--color-surface);
		color: var(--color-text);
		border: 1px solid var(--color-border);
		box-shadow: var(--shadow-sm);
	}

	.hero-link-secondary:hover,
	.hero-link-secondary:focus-visible {
		border-color: color-mix(in srgb, var(--color-text) 20%, var(--color-border));
	}

	.hero-media {
		display: flex;
		justify-content: center;
	}

	.hero-image-frame {
		position: relative;
		padding: var(--space-3);
		background: var(--color-surface);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-2xl);
		box-shadow: var(--shadow-xl);
	}

	.hero-image-frame::after {
		content: "";
		position: absolute;
		inset: -1px;
		border-radius: inherit;
		background: radial-gradient(circle at top, color-mix(in srgb, var(--color-accent) 15%, transparent), transparent 70%);
		pointer-events: none;
	}

	.hero-image {
		position: relative;
		width: min(18rem, 70vw);
		height: auto;
		aspect-ratio: 1 / 1;
		object-fit: cover;
		border-radius: var(--radius-xl);
		display: block;
	}
</style>
