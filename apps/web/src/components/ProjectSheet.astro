<style>
	.sheet {
		position: fixed;
		inset: 0;
		z-index: var(--z-sheet);
		inline-size: 100%;
		max-inline-size: none;
		block-size: 100%;
		max-block-size: none;
		margin: 0;
		padding: clamp(0.75rem, 2vw, 1.5rem);
		border: 0;
		background: transparent;
		color: var(--c-ink);
	}

	.sheet[open],
	.sheet:target,
	.sheet:has(:target) {
		display: grid;
		place-items: center;
	}

	.sheet:target,
	.sheet:has(:target) {
		background: rgb(20 20 19 / 72%);
	}

	.sheet::backdrop {
		background: rgb(20 20 19 / 72%);
	}

	.sheet__panel {
		display: flex;
		flex-direction: column;
		inline-size: min(100%, 86rem);
		block-size: 100%;
		max-block-size: 100dvh;
		overflow: hidden;
		border: 1px solid var(--c-line-strong);
		background: var(--c-ground);
	}

	.sheet__bar {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		padding: 0.8rem clamp(1rem, 3vw, 2rem);
		border-block-end: 1px solid var(--c-line);
		background: var(--c-ground);
	}

	.sheet__bar-index {
		color: var(--c-accent-ink);
	}

	.sheet__bar-title {
		display: none;
		color: var(--c-muted);
	}

	.sheet__close {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		min-block-size: 1.5rem;
		padding-block: 0.3rem;
		font-family: var(--f-mono);
		font-size: var(--t-xs);
		letter-spacing: 0.04em;
		text-transform: uppercase;
	}

	.sheet__close :global(svg) {
		transition: transform var(--motion-base) var(--motion-easing);
	}

	.sheet__close:hover :global(svg),
	.sheet__close:focus-visible :global(svg) {
		transform: rotate(90deg);
	}

	.sheet__scroll {
		flex: 1;
		overflow-y: auto;
		overscroll-behavior: contain;
	}

	.sheet__hero,
	.sheet__body,
	.sheet__foot {
		inline-size: min(100% - 2 * clamp(1rem, 4vw, 3.5rem), 78rem);
		margin-inline: auto;
	}

	.sheet__hero {
		padding-block: clamp(2rem, 5vw, 4.5rem) clamp(1.5rem, 4vw, 3rem);
	}

	.sheet__hero-grid {
		display: grid;
		gap: clamp(1.5rem, 4vw, 3rem);
	}

	.sheet__intro {
		display: grid;
		gap: 1rem;
		align-content: start;
	}

	.sheet__kicker {
		color: var(--c-accent-ink);
	}

	.sheet__title {
		max-inline-size: 16ch;
		font-size: clamp(2.4rem, 6.5vw, 5.6rem);
		font-weight: 500;
		line-height: 0.92;
		letter-spacing: -0.055em;
	}

	.sheet__summary {
		max-inline-size: 52ch;
		font-size: var(--t-m);
		line-height: 1.5;
		color: var(--c-muted);
	}

	.sheet__links {
		display: flex;
		flex-wrap: wrap;
		gap: 0.6rem;
		padding-block-start: 0.4rem;
	}

	.sheet__meta {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 1rem;
		align-content: end;
		padding-block-start: 1rem;
		border-block-start: 1px solid var(--c-line);
	}

	.sheet__meta dt {
		margin-block-end: 0.25rem;
		color: var(--c-muted);
	}

	.sheet__meta dd {
		font-size: var(--t-s);
		line-height: 1.4;
	}

	.sheet__plate {
		padding-block-start: clamp(1.5rem, 4vw, 3rem);
	}

	.sheet__body {
		display: grid;
		gap: clamp(2rem, 5vw, 4rem);
		padding-block: clamp(1rem, 3vw, 2rem) clamp(2rem, 5vw, 4rem);
	}

	.sheet__index-inner {
		display: grid;
		gap: 1rem;
	}

	.sheet__index-label,
	.sheet__disclosure {
		color: var(--c-muted);
	}

	.sheet__index nav ol {
		display: grid;
		border-block-start: 1px solid var(--c-line);
	}

	.sheet__index nav li {
		border-block-end: 1px solid var(--c-line);
	}

	.sheet__index nav a {
		display: flex;
		align-items: baseline;
		gap: 0.6rem;
		padding-block: 0.55rem;
		font-size: var(--t-s);
		color: var(--c-muted);
		transition: color var(--motion-base) var(--motion-easing);
	}

	.sheet__index nav a:hover,
	.sheet__index nav a:focus-visible {
		color: var(--c-ink);
	}

	.sheet__index nav .mono {
		color: var(--c-accent-ink);
	}

	.sheet__prose {
		max-inline-size: 70ch;
	}

	.sheet__foot {
		display: grid;
		gap: 0.8rem;
		padding-block: clamp(1.5rem, 4vw, 3rem) clamp(2rem, 5vw, 3.5rem);
		border-block-start: 1px solid var(--c-line);
	}

	.sheet__foot > .mono {
		color: var(--c-muted);
	}

	.sheet__next {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		font-size: clamp(1.5rem, 3.5vw, 2.8rem);
		font-weight: 500;
		line-height: 1;
		letter-spacing: -0.04em;
	}

	.sheet__next :global(svg) {
		flex-shrink: 0;
		inline-size: clamp(1.3rem, 2.4vw, 2rem);
		block-size: auto;
		color: var(--c-accent);
		transition: transform var(--motion-base) var(--motion-easing);
	}

	.sheet__next:hover :global(svg),
	.sheet__next:focus-visible :global(svg) {
		transform: translate(4px, -4px);
	}

	.sheet__back {
		justify-self: start;
		padding-block: 0.25rem;
		font-family: var(--f-mono);
		font-size: var(--t-xs);
		letter-spacing: 0.04em;
		text-transform: uppercase;
		color: var(--c-muted);
		text-decoration: underline;
		text-decoration-color: var(--c-line-strong);
		text-underline-offset: 0.3em;
	}

	.sheet__back:hover,
	.sheet__back:focus-visible {
		color: var(--c-ink);
		text-decoration-color: var(--c-accent);
	}

	@media (min-width: 720px) {
		.sheet__bar-title {
			display: block;
		}

		.sheet__meta {
			grid-template-columns: repeat(4, minmax(0, 1fr));
		}
	}

	@media (min-width: 900px) {
		.sheet__hero-grid {
			grid-template-columns: minmax(0, 1.25fr) minmax(0, 0.75fr);
			align-items: end;
		}

		.sheet__body {
			grid-template-columns: minmax(0, 2.4fr) minmax(0, 7.6fr);
			gap: clamp(2.5rem, 6vw, 5rem);
		}

		.sheet__index-inner {
			position: sticky;
			inset-block-start: 1.5rem;
		}

		.sheet__foot {
			grid-template-columns: minmax(0, 1fr) auto;
			align-items: end;
		}

		.sheet__foot > .mono {
			grid-column: 1 / -1;
		}

		.sheet__next {
			grid-column: 1;
		}

		.sheet__back {
			grid-column: 2;
			grid-row: 2;
		}
	}

	@media (max-width: 719px) {
		.sheet {
			padding: 0;
		}

		.sheet__panel {
			border: 0;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.sheet__close :global(svg),
		.sheet__next :global(svg),
		.sheet__index nav a {
			transition: none;
		}
	}
</style> -->
